  document.getElementById("runningbox").style.display="";
  var el=document.getElementById("rootmods");
  if(!d.mods||!d.mods.length){el.innerHTML="<p class='note'>No modules in the drop folder.</p>";return;}
  el.innerHTML=d.mods.map(function(m){return "<form method='post' action='"+esc(base)
    +"/projects/ingest-root'><input type='hidden' name='file' value='"+esc(m)
    +"'><b>"+esc(m)+"</b> <input type='text' name='slug' value='"
    +esc(m.replace(/\\.[^.]*$/,""))+"'> <button type='submit'>Ingest</button></form>";}).join("");
}).catch(function(){document.getElementById("rootmods").innerHTML=
  "<p class='note'>Start the console (step 1) to list the drop folder.</p>";});
</script></body></html>"""


def render_start():
    """Serve the standalone start.html verbatim (fallback if the file is gone).

    start.html is fully self-contained - it works opened directly as a file
    (its upload form posts to the console; JS lists the drop folder via
    /api/root-mods) and identically when served here at /start. Nothing is
    templated, so what you edit in the file is exactly what is served.
    """
    if LANDING_DIR:
        path = os.path.join(LANDING_DIR, "start.html")
        if os.path.isfile(path):
            try:
                with open(path, encoding="utf-8") as fh:
                    return fh.read()
            except OSError:
                pass
    return FALLBACK_START_HTML


def render_project_home(proj):
    n = proj.area_count()
    src = proj.source_mod()
    built = proj.built_mod_path()
    rows = []
    rows.append("<div class='card'><h3>Edit</h3>"
                "<p><a href='%s'>Areas</a> - %d found - bulk-edit event "
                "scripts, lighting/fog, tags/resrefs.</p>"
                "<p><a href='%s'>Creatures</a> - %d blueprints - stats, "
                "feats, appearance.</p>"
                "<p><a href='%s'>Module info</a> - name &amp; description.</p></div>"
                % (purl("/areas"), n, purl("/creatures"), proj.creature_count(),
                   purl("/module")))

    ingest = ("<form method='post' action='%s'>"
              "<button type='submit'>Re-ingest from source .mod</button></form>"
              % purl("/ingest"))
    src_note = ("<p class='note'>Source: %s</p>" % esc(src) if src else
                "<p class='warn'>No recorded source .mod (.nasher/source); "
                "re-ingest unavailable.</p>")
    rows.append("<div class='card'><h3>Ingest</h3><div class='actions'>%s</div>%s</div>"
                % (ingest if src else "", src_note))

    wiki_actions = ["<form method='post' action='%s'>"
                    "<button type='submit'>Rebuild wiki</button></form>"
                    % purl("/wiki")]
    if proj.has_wiki():
        wiki_actions.append("<a href='%s'>View wiki</a>" % purl("/wiki/"))
        wiki_actions.append("<a href='%s'>View map</a>" % purl("/wiki/map/"))
    rows.append("<div class='card'><h3>Wiki</h3><div class='actions'>%s</div>"
                "<p class='note'>Runs <code>nwn-manager wiki</code> "
                "(~30s), served here at %s.</p></div>"
                % (" ".join(wiki_actions), esc(purl("/wiki/"))))

    build_actions = ["<form method='post' action='%s'>"
                     "<button type='submit'>Build module</button></form>"
                     % purl("/build")]
    if built:
        build_actions.append("<a href='%s'>Download %s.mod</a>"
                             % (purl("/download"), esc(proj.slug)))
    built_note = ("<p class='note'>Last build: %s</p>" % esc(os.path.basename(built))
                  if built else
                  "<p class='note'>Not built yet.</p>")
    rows.append("<div class='card'><h3>Build &amp; download</h3>"
                "<div class='actions'>%s</div>%s"
                "<p class='note'>Runs <code>nwn-manager repack</code> "
                "(compile + pack, may take minutes).</p></div>"
                % (" ".join(build_actions), built_note))

    return page("Project: %s" % proj.slug, "<div class='grid'>%s</div>" % "".join(rows))


def render_job_page(job):
    head = "<meta http-equiv='refresh' content='2'>" if job.state == "running" else ""
    tail = "\n".join(job.lines[-50:])
    if job.state == "running":
        status = "<p class='phase'>Running: %s</p>" % esc(job.phase)
    elif job.state == "ok":
        status = "<p class='ok phase'>Completed: %s</p>" % esc(job.phase)
    else:
        status = "<p class='err phase'>Failed: %s</p>" % esc(job.phase)
    links = []
    if job.state == "ok" and job.slug:
        if job.kind == "build":
            links.append("<a href='%s'>Download .mod</a>"
                         % gurl("/p/%s/download" % job.slug))
        elif job.kind == "wiki":
            links.append("<a href='%s'>View wiki</a>"
                         % gurl("/p/%s/wiki/" % job.slug))
        links.append("<a href='%s'>Open project</a>" % gurl("/p/%s/" % job.slug))
    elif job.slug:
        links.append("<a href='%s'>Back to project</a>" % gurl("/p/%s/" % job.slug))
    links.append("<a href='%s'>Dashboard</a>" % gurl("/"))
    body = ("%s<p>%s</p><pre class='log'>%s</pre><p>%s</p>" %
            (status, esc(job.title), esc(tail) or "(no output yet)",
             " &nbsp; ".join(links)))
    return page("Job: %s" % job.title, body, head_extra=head)


# --- HTTP handler -----------------------------------------------------------

class Handler(BaseHTTPRequestHandler):
    url_prefix = ""   # e.g. "/qedit" when reverse-proxied under a subpath

    def _strip_proxy(self, path):
        if self.url_prefix and path.startswith(self.url_prefix):
            return path[len(self.url_prefix):] or "/"
        return path

    def _send(self, content, code=200):
        data = content.encode()
        try:
            self.send_response(code)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
            self._client_gone()

    def _send_bytes(self, data, ctype, code=200, extra_headers=None):
        try:
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            for k, v in (extra_headers or {}).items():
                self.send_header(k, v)
            self.end_headers()
            self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
            self._client_gone()

    def _client_gone(self):
        # The browser closed the connection (closed the tab, navigated away,
        # double-submitted a form) before we finished sending the response.
        # Any server-side work already done (e.g. a file write in apply_*)
        # already completed - only response delivery failed, so there's
        # nothing to recover; just log one quiet line instead of letting the
        # exception surface as an unhandled-error traceback.
        sys.stderr.write("%s - client disconnected before response finished\n"
                         % self.address_string())

    def _send_json(self, obj, code=200, cors=False):
        headers = {"Access-Control-Allow-Origin": "*"} if cors else None
        self._send_bytes(json.dumps(obj).encode(), "application/json",
                         code=code, extra_headers=headers)

    def _redirect(self, url):
        try:
            self.send_response(303)
            self.send_header("Location", url)
            self.send_header("Content-Length", "0")
            self.end_headers()
        except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
            self._client_gone()

    def _form(self):
        length = int(self.headers.get("Content-Length", 0))
        return urllib.parse.parse_qs(self.rfile.read(length).decode(),
                                     keep_blank_values=True)

    def log_message(self, fmt, *args):  # quieter default log
        sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))

    @staticmethod
    def _split_project(path):
        # "/p/<slug>/rest" -> (slug, "/rest")
        rest = path[len("/p/"):]
        slug, sep, tail = rest.partition("/")
        return slug, ("/" + tail if sep else "/")

    # -- GET ----------------------------------------------------------------
    def do_GET(self):
        _req.proxy = self.url_prefix
        _req.slug = None
        _req.project = None
        raw = urllib.parse.urlparse(self.path)
        query = urllib.parse.parse_qs(raw.query)
        path = self._strip_proxy(raw.path)
        try:
            if SINGLE_MODE:
                _req.project = SINGLE_PROJECT
                self._project_get(SINGLE_PROJECT, path, query)
                return
            if path == "/":
                self._send(render_dashboard())
            elif path == "/start":
                self._send(render_start())
            elif path == "/api/root-mods":
                # Consumed by start.html's JS; CORS-open so the page works even
                # when opened directly as a file:// document.
                self._send_json({"landing_dir": LANDING_DIR or "",
                                 "mods": root_mod_files()}, cors=True)
            elif path.startswith("/jobs/"):
                job = get_job(path[len("/jobs/"):])
                if not job:
                    self._send(page("Unknown job", "<p class='err'>No such job.</p>"
                                    "<p><a href='%s'>Dashboard</a></p>" % gurl("/")), 404)
                else:
                    self._send(render_job_page(job))
            elif path.startswith("/p/"):
                slug, sub = self._split_project(path)
                proj = find_project(slug)
                if not proj:
                    self._send(page("Unknown project",
                                    "<p class='err'>No such project.</p>"
                                    "<p><a href='%s'>Dashboard</a></p>" % gurl("/")), 404)
                    return
                _req.slug = proj.slug
                _req.project = proj
                self._project_get(proj, sub, query)
            else:
                self._send(page("Not found", "<p>No such page.</p>"), 404)
        except Exception as e:  # noqa: BLE001
            self._send(page("Error", "<p class='err'>%s</p>" % esc(e)), 500)

    def _project_get(self, proj, sub, query):
        root = proj.unpacked
        if sub == "/":
            if SINGLE_MODE:
                self._send(page("NWN area editor",
                    "<ul><li><a href='%s'>Areas</a> - %d found - bulk-edit "
                    "event scripts, lighting/fog, tags/resrefs</li></ul>"
                    "<p class='note'>Data dir: %s.</p>"
                    % (purl("/areas"), proj.area_count(), esc(root))))
            else:
                self._send(render_project_home(proj))
        elif sub == "/areas":
            self._send(render_areas(root, query))
        elif sub == "/areas/edit":
            resrefs = [r for r in query.get("res", [])
                       if os.path.exists(are_path(root, r))]
            action = query.get("action", ["scripts"])[0]
            if not resrefs:
                self._send(page("Unknown area",
                                "<p class='err'>No such area here.</p>"
                                "<p><a href='%s'>Area list</a></p>" % purl("/areas")), 404)
                return
            if action == "remove_objects":
                self._send(render_remove_objects_form(root, proj.git_root, resrefs))
                return
            render = {"scripts": render_scripts_form,
                      "lighting": render_lighting_form,
                      "music": render_music_form,
                      "tags": render_tags_form}.get(action, render_scripts_form)
            self._send(render(root, resrefs))
        elif sub == "/areas/map":
            self._send(render_area_map(proj))
        elif sub == "/creatures":
            self._send(render_creatures(root, query))
        elif sub == "/creature":
            res = query.get("res", [""])[0]
            cpath = utc_path(root, res)
            if not os.path.isfile(cpath):
                self._send(page("Unknown creature",
                                "<p class='err'>No such creature.</p>"
                                "<p><a href='%s'>Creatures</a></p>"
                                % purl("/creatures")), 404)
                return
            d = load_cached(cpath)
            ident = "<input type='hidden' name='res' value='%s'>" % esc(res)
            self._send(page("Creature: " + res,
                            render_char_form(d, purl("/creature/apply"), ident)))
        elif sub == "/module":
            if not os.path.isfile(module_ifo_path(root)):
                self._send(page("No module.ifo",
                                "<p class='err'>No module.ifo.json here.</p>"), 404)
                return
            d = load_cached(module_ifo_path(root))
            self._send(page("Module Info", render_module_form(d)))
        elif sub == "/download":
            self._serve_download(proj)
        elif sub == "/wiki" or sub.startswith("/wiki/"):
            rel = sub[len("/wiki"):].lstrip("/")
            self._serve_static(proj.docs, rel)
        else:
            self._send(page("Not found", "<p>No such page.</p>"), 404)

    # -- POST ---------------------------------------------------------------
    def do_POST(self):
        _req.proxy = self.url_prefix
        _req.slug = None
        _req.project = None
        raw = urllib.parse.urlparse(self.path)
        path = self._strip_proxy(raw.path)
        try:
            if path == "/shutdown":
                self._shutdown()
                return
            if not SINGLE_MODE and path == "/projects/new":
                self._create_project()
                return
            if not SINGLE_MODE and path == "/projects/ingest-root":
                self._ingest_root(self._form())
                return
            if SINGLE_MODE:
                _req.project = SINGLE_PROJECT
                self._project_post(SINGLE_PROJECT, path, self._form())
                return
            if path.startswith("/p/"):
                slug, sub = self._split_project(path)
                proj = find_project(slug)
                if not proj:
                    self._send(page("Unknown project",
                                    "<p class='err'>No such project.</p>"), 404)
                    return
                _req.slug = proj.slug
                _req.project = proj
                self._project_post(proj, sub, None)
                return
            self._send(page("Not found", "<p>No such action.</p>"), 404)
        except Exception as e:  # noqa: BLE001
            self._send(page("Error", "<p class='err'>%s</p>" % esc(e)), 500)

    def _project_post(self, proj, sub, form):
        # Lifecycle actions take no form body; area edits are urlencoded.
        if sub in ("/ingest", "/wiki", "/build"):
            self._project_action(proj, sub)
            return
        if form is None:
            form = self._form()
        root = proj.unpacked
        if sub == "/areas/select":
            resrefs = form.get("res", [])
            action = form.get("action", [""])[0]
            if not resrefs:
                self._send(page("No areas selected",
                                "<p><a href='%s'>Back</a></p>" % purl("/areas")))
                return
            if action == "remove_objects":
                self._send(render_remove_objects_form(root, proj.git_root, resrefs))
                return
            render = {"scripts": render_scripts_form,
                      "lighting": render_lighting_form,
                      "music": render_music_form,
                      "tags": render_tags_form}[action]
            self._send(render(root, resrefs))
        elif sub == "/areas/scripts/apply":
            self._send(apply_scripts(root, form))
        elif sub == "/areas/lighting/apply":
            self._send(apply_lighting(root, form))
        elif sub == "/areas/music/apply":
            self._send(apply_music(root, form))
        elif sub == "/areas/tags/apply":
            self._send(apply_tags(root, proj.git_root, proj.gic_root, form))
        elif sub == "/areas/objects/apply":
            self._send(apply_remove_objects(root, proj.git_root, form))
        elif sub == "/creature/apply":
            res = form.get("res", [""])[0]
            cpath = utc_path(root, res)
            d = json_load(cpath)
            if apply_char_edits(d, form):
                json_save(cpath, d)
                invalidate(cpath)
            self._send(page("Saved", "<p class='ok'>%s saved.</p>"
                            "<p><a href='%s'>Back</a></p>" %
                            (esc(res), purl("/creature?res="
                                            + urllib.parse.quote(res)))))
        elif sub == "/module/apply":
            touched = apply_module(root, form)
            msg = "Module info saved." if touched else "No changes."
            self._send(page("Saved", "<p class='ok'>%s</p>"
                            "<p><a href='%s'>Back</a></p>"
                            % (esc(msg), purl("/module"))))
        else:
            self._send(page("Not found", "<p>No such action.</p>"), 404)

    def _project_action(self, proj, sub):
        if sub == "/ingest":
            job = Job("Re-ingest %s" % proj.slug,
                      [NWN_MANAGER, "unpack"], cwd=proj.root,
                      kind="ingest", slug=proj.slug)
            job.phase = "unpacking module"
        elif sub == "/wiki":
            job = Job("Wiki %s" % proj.slug,
                      [NWN_MANAGER, "wiki"], cwd=proj.root,
                      kind="wiki", slug=proj.slug)
            job.phase = "generating wiki"
        else:  # /build
            job = Job("Build %s" % proj.slug,
                      [NWN_MANAGER, "repack"], cwd=proj.root,
                      kind="build", slug=proj.slug)
            job.phase = "starting build"
        start_job(job)
        self._redirect(gurl("/jobs/" + job.id))

    def _shutdown(self):
        """Stop the console server (the 'Stop console' button)."""
        self._send(page("Console stopped",
                        "<p class='ok'>The console has been stopped. You can "
                        "close this tab.</p>"
                        "<p class='note'>To start it again, run "
                        "<code>bin/nwn-manager console</code> from the repository "
                        "root, then reload.</p>"))

        def _stop():
            time.sleep(0.3)
            try:
                if SERVER is not None:
                    SERVER.shutdown()
                else:
                    os._exit(0)
            except Exception:  # noqa: BLE001
                os._exit(0)

        threading.Thread(target=_stop, daemon=True).start()

    def _create_project(self):
        fields, files = parse_multipart(self.headers, self.rfile)
        mod_list = files.get("module", [])
        if not mod_list or not mod_list[0][1]:
            self._send(page("Upload error",
                            "<p class='err'>No module file uploaded.</p>"
                            "<p><a href='%s'>Dashboard</a></p>" % gurl("/")), 400)
            return
        mod_filename, mod_bytes = mod_list[0]
        want = fields.get("slug", [""])[0].strip()
        slug = sanitize_slug(want or os.path.splitext(safe_basename(mod_filename))[0])
        if not slug:
            self._send(page("Upload error",
                            "<p class='err'>Could not derive a project name.</p>"
                            "<p><a href='%s'>Dashboard</a></p>" % gurl("/")), 400)
            return
        proj_dir = os.path.join(PROJECTS_DIR, slug)
        if os.path.exists(proj_dir):
            self._send(page("Upload error",
                            "<p class='err'>Project %r already exists.</p>"
                            "<p><a href='%s'>Dashboard</a></p>" % (slug, gurl("/"))), 409)
            return
        # Stage the uploaded .mod persistently (not in /tmp): `nwn-manager init`
        # records this path as .nasher/source, which "Re-ingest from source"
        # later re-reads - so it must outlive the ingest job.
        uploads = os.path.join(PROJECTS_DIR, ".uploads")
        os.makedirs(uploads, exist_ok=True)
        mod_path = os.path.join(uploads, slug + ".mod")
        with open(mod_path, "wb") as fh:
            fh.write(mod_bytes)
        stage = tempfile.mkdtemp(prefix="qnwn_up_")
        extras = []  # (basename, staged_path)
        for fn, data in files.get("extra", []):
            if not fn or not data:
                continue
            bn = safe_basename(fn)
            sp = os.path.join(stage, "extra_" + bn)
            with open(sp, "wb") as fh:
                fh.write(data)
            extras.append((bn, sp))
        self._start_ingest(slug, mod_path, extras, cleanup=stage)

    def _ingest_root(self, form):
        """Ingest a .mod/.erf the user dropped into LANDING_DIR (the repo root)."""
        chosen = safe_basename(form.get("file", [""])[0])
        want = form.get("slug", [""])[0].strip()
        if chosen not in set(root_mod_files()):
            self._send(page("Ingest error",
                            "<p class='err'>No such module in the drop folder.</p>"
                            "<p><a href='%s'>Back to start</a></p>" % gurl("/start")),
                       400)
            return
        mod_path = os.path.join(LANDING_DIR, chosen)
        slug = sanitize_slug(want or os.path.splitext(chosen)[0])
        if not slug:
            self._send(page("Ingest error",
                            "<p class='err'>Could not derive a project name.</p>"
                            "<p><a href='%s'>Back to start</a></p>" % gurl("/start")),
                       400)
            return
        proj_dir = os.path.join(PROJECTS_DIR, slug)
        if os.path.exists(proj_dir):
            self._send(page("Ingest error",
                            "<p class='err'>Project %r already exists.</p>"
                            "<p><a href='%s'>Back to start</a></p>"
                            % (slug, gurl("/start"))), 409)
            return
        # No copy: the module intentionally lives in the root; `init` records it
        # as .nasher/source so re-ingest keeps working while the file remains.
        self._start_ingest(slug, mod_path, extras=[], cleanup=None)

    def _start_ingest(self, slug, mod_path, extras=(), cleanup=None):
        """Kick a background `nwn-manager init` job and redirect to its status.

        extras: list of (basename, staged_path) copied into unpacked/ on success.
        cleanup: optional temp dir removed once the job finishes.
        """
        proj_dir = os.path.join(PROJECTS_DIR, slug)

        def on_success(job):
            unpacked = os.path.join(proj_dir, "unpacked")
            for bn, sp in extras:
                try:
                    shutil.copy(sp, os.path.join(unpacked, bn))
                    job.add("[console] copied extra file %s -> unpacked/" % bn)
                except OSError as exc:
                    job.add("[console] WARN could not copy %s: %s" % (bn, exc))
            if cleanup:
                shutil.rmtree(cleanup, ignore_errors=True)

        job = Job("Ingest %s" % slug,
                  [NWN_MANAGER, "init", proj_dir, mod_path],
                  cwd=PROJECTS_DIR, kind="ingest", slug=slug,
                  on_success=on_success)
        start_job(job)
        self._redirect(gurl("/jobs/" + job.id))

    # -- static/download helpers -------------------------------------------
    def _serve_static(self, docroot, rel):
        if not os.path.isdir(docroot):
            self._send(page("No wiki",
                            "<p class='err'>No wiki generated yet.</p>"
                            "<p><a href='%s'>Rebuild it</a></p>" % purl("/")), 404)
            return
        rel = rel or "index.html"
        docroot_real = os.path.realpath(docroot)
        full = os.path.realpath(os.path.join(docroot, rel))
        if full != docroot_real and not full.startswith(docroot_real + os.sep):
            self._send(page("Forbidden", "<p class='err'>Path escape.</p>"), 403)
            return
        if os.path.isdir(full):
            full = os.path.join(full, "index.html")
        if not os.path.isfile(full):
            self._send(page("Not found", "<p class='err'>No such wiki file.</p>"), 404)
            return
        ctype = mimetypes.guess_type(full)[0] or "application/octet-stream"
        with open(full, "rb") as fh:
            self._send_bytes(fh.read(), ctype)

    def _serve_download(self, proj):
        mod = proj.built_mod_path()
        if not mod or not os.path.isfile(mod):
            self._send(page("Not built",
                            "<p class='err'>No built .mod yet - build first.</p>"
                            "<p><a href='%s'>Back</a></p>" % purl("/")), 404)
            return
        with open(mod, "rb") as fh:
            self._send_bytes(
                fh.read(), "application/octet-stream",
                extra_headers={"Content-Disposition":
                               'attachment; filename="%s.mod"' % proj.slug})


def _find_nwn_manager(explicit):
    candidates = [explicit] if explicit else []
    candidates.append(os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                   "nwn-manager"))
    found = shutil.which("nwn-manager")
    if found:
        candidates.append(found)
    for c in candidates:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return candidates[0]  # best guess; jobs will surface the error if wrong


def main():
    global PROJECTS_DIR, SINGLE_MODE, SINGLE_PROJECT, NWN_MANAGER
    global WIKI_SHELL, WIKI_BASE
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--projects-dir", default=None,
                    help="root dir holding one subdirectory per project "
                         "(multi-project console mode)")
    ap.add_argument("--dir", default=None,
                    help="legacy single-project mode: a directory of "
                         "<resref>.are.json (the console dashboard is disabled)")
    ap.add_argument("--git-dir", default=None,
                    help="(single-dir mode) dir of <resref>.git.json")
    ap.add_argument("--gic-dir", default=None,
                    help="(single-dir mode) dir of <resref>.gic.json")
    ap.add_argument("--port", type=int, default=8341)
    ap.add_argument("--host", default="127.0.0.1")
    ap.add_argument("--url-prefix", default="",
                    help="serve under this path prefix (e.g. /qedit) when "
                         "behind a reverse proxy")
    ap.add_argument("--nav", action="append", default=[], metavar="LABEL=URL",
                    help="extra nav-bar link (repeatable), e.g. --nav 'Wiki=/tfn-wiki/'")
    ap.add_argument("--wiki-shell", default=None, metavar="FILE",
                    help="path to an nwn-wiki assets/embed-shell.html; wraps "
                         "every page in the wiki's header/nav/styles")
    ap.add_argument("--wiki-base", default="", metavar="URL",
                    help="public base URL of that wiki, substituted for the "
                         "shell's {{ROOT}} asset paths")
    ap.add_argument("--nwn-manager", default=None,
                    help="path to the nwn-manager wrapper (default: sibling in bin/)")
    ap.add_argument("--landing-dir", default=None,
                    help="where start.html lives and dropped .mod files are "
                         "scanned (default: the repo root above bin/)")
    args = ap.parse_args()

    global LANDING_DIR
    NWN_MANAGER = _find_nwn_manager(args.nwn_manager)
    LANDING_DIR = os.path.abspath(
        args.landing_dir or os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
    Handler.url_prefix = args.url_prefix.rstrip("/")
    NAV_EXTRA[:] = [(label, url) for label, _, url in
                    (n.partition("=") for n in args.nav) if url]
    if args.wiki_shell:
        with open(args.wiki_shell) as fh:
            WIKI_SHELL = fh.read()
        WIKI_BASE = args.wiki_base.rstrip("/")

    if args.dir and not args.projects_dir:
        SINGLE_MODE = True
        d = os.path.abspath(args.dir)
        SINGLE_PROJECT = Project(os.path.dirname(d) or d, unpacked=d,
                                 git_root=args.git_dir, gic_root=args.gic_dir)
        print("single-project dir: %s" % d)
    else:
        if not args.projects_dir:
            ap.error("one of --projects-dir (console) or --dir (single) is required")
        PROJECTS_DIR = os.path.abspath(args.projects_dir)
        os.makedirs(PROJECTS_DIR, exist_ok=True)
        print("projects dir: %s" % PROJECTS_DIR)

    global SERVER
    print("nwn-manager: %s" % NWN_MANAGER)
    srv = ThreadingHTTPServer((args.host, args.port), Handler)
    SERVER = srv
    base = "http://%s:%d%s" % (args.host, args.port, Handler.url_prefix)
    print("Serving on %s/ (Ctrl-C to stop)" % base, flush=True)
    if not SINGLE_MODE:
        print("  ingest start page: %s/start   (drop folder: %s)"
              % (base, LANDING_DIR), flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    main()
