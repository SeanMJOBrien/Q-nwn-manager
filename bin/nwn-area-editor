def _nav():
    extra = "".join('<a href="%s">%s</a>' % (esc(u), esc(l))
                    for l, u in NAV_EXTRA)
    proj = getattr(_req, "project", None)
    links = []
    if SINGLE_MODE:
        links.append("<a href='%s'>Areas</a>" % purl("/areas"))
        if proj and proj.creature_count():
            links.append("<a href='%s'>Creatures</a>" % purl("/creatures"))
        if proj and proj.has_module():
            links.append("<a href='%s'>Module</a>" % purl("/module"))
        links.append("<a href='%s'>Area Map</a>" % purl("/areas/map"))
    else:
        links.append("<a href='%s'>Dashboard</a>" % gurl("/"))
        if _slug():
            links.append("<a href='%s'>%s</a>" % (purl("/"), esc(_slug())))
            links.append("<a href='%s'>Areas</a>" % purl("/areas"))
            links.append("<a href='%s'>Creatures</a>" % purl("/creatures"))
            links.append("<a href='%s'>Module</a>" % purl("/module"))
            links.append("<a href='%s'>Area Map</a>" % purl("/areas/map"))
            if _has_wiki_current():
                links.append("<a href='%s'>Wiki</a>" % purl("/wiki/"))
                links.append("<a href='%s'>Map</a>" % purl("/wiki/map/"))
    stop = ("<form method='post' action='%s' class='stop-console' "
            "onsubmit=\"return confirm('Stop the console server?')\">"
            "<button type='submit'>Stop console</button></form>" % gurl("/shutdown"))
    return "<div class='nav'>%s%s%s</div>" % ("".join(links), extra, stop)


def _has_wiki_current():
    proj = getattr(_req, "project", None)
    return bool(proj and proj.has_wiki())


def page(title, body, head_extra=""):
    nav = _nav()
    if WIKI_SHELL:
        inner = ("<style>%s</style>%s<h1>%s</h1>%s"
                 % (SHELL_CSS, nav, esc(title), body))
        return (WIKI_SHELL.replace("{{ROOT}}", WIKI_BASE)
                .replace("{{TITLE}}", esc(title))
                .replace("{{BODY}}", inner))
    return ("<!doctype html><html><head><meta charset='utf-8'><title>%s</title>"
            "%s<style>%s</style></head><body>%s"
            "<h1>%s</h1>%s</body></html>" % (esc(title), head_extra, CSS, nav,
                                             esc(title), body))


def hidden_resrefs(resrefs):
    return "".join("<input type='hidden' name='res' value='%s'>" % esc(r)
                   for r in resrefs)


# --- Project model ----------------------------------------------------------

def sanitize_slug(name):
    return re.sub(r"[^a-z0-9_]+", "_", (name or "").lower()).strip("_")[:48]


def safe_basename(name):
    return os.path.basename((name or "").replace("\\", "/")).strip() or "file"


class Project:
    def __init__(self, root, unpacked=None, git_root=None, gic_root=None):
        self.root = os.path.abspath(root)
        self.slug = os.path.basename(self.root)
        self.unpacked = (os.path.abspath(unpacked) if unpacked
                         else os.path.join(self.root, "unpacked"))
        self.git_root = os.path.abspath(git_root) if git_root else self.unpacked
        self.gic_root = os.path.abspath(gic_root) if gic_root else self.unpacked

    @property
    def docs(self):
        return os.path.join(self.root, "docs")

    def has_unpacked(self):
        return os.path.isdir(self.unpacked)

    def has_wiki(self):
        return os.path.isfile(os.path.join(self.docs, "index.html"))

    def area_count(self):
        if not self.has_unpacked():
            return 0
        return len(glob.glob(os.path.join(self.unpacked, "*.are.json")))

    def creature_count(self):
        if not self.has_unpacked():
            return 0
        return len(glob.glob(os.path.join(self.unpacked, "*.utc.json")))

    def has_module(self):
        return os.path.isfile(os.path.join(self.unpacked, "module.ifo.json"))

    def built_mod_path(self):
        cands = (glob.glob(os.path.join(self.root, "*.mod"))
                 + glob.glob(os.path.join(self.root, "dist", "*.mod")))
        return max(cands, key=os.path.getmtime) if cands else None

    def source_mod(self):
        p = os.path.join(self.root, ".nasher", "source")
        if os.path.isfile(p):
            try:
                return open(p).read().strip()
            except OSError:
                return None
        return None


def is_project_dir(d):
    return os.path.isdir(d) and (
        os.path.isfile(os.path.join(d, "nasher.cfg"))
        or os.path.isdir(os.path.join(d, "unpacked")))


def find_project(slug):
    slug = sanitize_slug(slug)
    if not slug or SINGLE_MODE or not PROJECTS_DIR:
        return None
    d = os.path.join(PROJECTS_DIR, slug)
    return Project(d) if is_project_dir(d) else None


def list_projects():
    if not PROJECTS_DIR or not os.path.isdir(PROJECTS_DIR):
        return []
    out = []
    for name in sorted(os.listdir(PROJECTS_DIR)):
        d = os.path.join(PROJECTS_DIR, name)
        if is_project_dir(d):
            out.append(Project(d))
    return out


# --- Background jobs ---------------------------------------------------------

_JOBS = {}
_JOBS_LOCK = threading.Lock()


class Job:
    def __init__(self, title, argv, cwd=None, kind=None, slug=None,
                 on_success=None):
        self.id = uuid.uuid4().hex[:12]
        self.title = title
        self.argv = argv
        self.cwd = cwd
        self.kind = kind          # ingest | wiki | build
        self.slug = slug
        self.on_success = on_success
        self.state = "running"    # running | ok | failed
        self.phase = "starting"
        self.lines = []
        self.built = None
        self.started = time.time()
        self.ended = None

    def add(self, line):
        self.lines.append(line)
        if len(self.lines) > 800:
            del self.lines[:len(self.lines) - 800]


def _parse_phase(job, line):
    if re.match(r"^Packing ", line):
        job.phase = "packing"
    elif re.match(r"^Compiling ", line):
        m = re.match(r"^Compiling (\d+)", line)
        job.phase = "compiling %s scripts" % (m.group(1) if m else "?")
    elif re.match(r"^Updating ", line) and job.phase in ("starting", "converting"):
        job.phase = "converting"
    elif line.startswith("[nwn-manager]"):
        msg = line.split("]", 1)[1].strip()
        if msg:
            job.phase = msg[:100]
    m = re.search(r"\[nwn-manager\] built: (.+)$", line)
    if m:
        job.built = m.group(1).strip()


def _run_job(job):
    try:
        # Line-buffer the child's stdout when possible so phase lines show up
        # live instead of all at once at process exit (the child block-buffers
        # its pipe because stdout is not a TTY).
        argv = job.argv
        if shutil.which("stdbuf"):
            argv = ["stdbuf", "-oL", "-eL"] + list(job.argv)
        proc = subprocess.Popen(
            argv, cwd=job.cwd, stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT, text=True, bufsize=1, env=os.environ)
        for line in proc.stdout:
            line = line.rstrip("\n")
            job.add(line)
            _parse_phase(job, line)
        proc.wait()
        if proc.returncode != 0:
            job.state = "failed"
            job.phase = "failed (exit %d)" % proc.returncode
            job.ended = time.time()
            return
        if job.on_success:
            job.on_success(job)
        job.state = "ok"
        job.phase = "done"
        job.ended = time.time()
    except Exception as exc:  # noqa: BLE001 - surface any launch failure
        job.add("ERROR: %s" % exc)
        job.state = "failed"
        job.phase = "error"
        job.ended = time.time()


def start_job(job):
    with _JOBS_LOCK:
        _JOBS[job.id] = job
    threading.Thread(target=_run_job, args=(job,), daemon=True).start()
    return job


def get_job(jid):
    with _JOBS_LOCK:
        return _JOBS.get(jid)


# --- Multipart parsing (stdlib only; `cgi` is gone in Python 3.13+) ---------

def parse_multipart(headers, rfile):
    """Return (fields, files): name -> [str] and name -> [(filename, bytes)]."""
    ctype = headers.get("Content-Type", "")
    fields, files = {}, {}
    if "multipart/form-data" not in ctype:
        return fields, files
    m = re.search(r"boundary=([^;]+)", ctype)
    if not m:
        return fields, files
    boundary = m.group(1).strip().strip('"')
    length = int(headers.get("Content-Length", 0))
    body = rfile.read(length)
    delim = b"--" + boundary.encode()
    for part in body.split(delim):
        if part in (b"", b"--", b"--\r\n", b"\r\n"):
            continue
        if part.startswith(b"\r\n"):
            part = part[2:]
        if part.endswith(b"\r\n"):
            part = part[:-2]
        if b"\r\n\r\n" not in part:
            continue
        raw_headers, _, data = part.partition(b"\r\n\r\n")
        hlines = raw_headers.decode("utf-8", "replace").split("\r\n")
        disp = next((h for h in hlines
                     if h.lower().startswith("content-disposition")), "")
        nm = re.search(r'name="([^"]*)"', disp)
        if not nm:
            continue
        name = nm.group(1)
        fn = re.search(r'filename="([^"]*)"', disp)
        if fn is not None:
            files.setdefault(name, []).append((fn.group(1), data))
        else:
            fields.setdefault(name, []).append(
                data.decode("utf-8", "replace"))
    return fields, files


# --- Area logic -------------------------------------------------------------

AREA_SCRIPT_FIELDS = ["OnEnter", "OnExit", "OnHeartbeat", "OnUserDefined"]
LIGHT_NUM_FIELDS = [
    ("SunFogAmount", "byte", "0-15"),
    ("MoonFogAmount", "byte", "0-15"),
    ("FogClipDist", "float", "e.g. 45.0"),
    ("DayNightCycle", "byte", "0=static 1=cycle"),
    ("IsNight", "byte", "0/1 (when static)"),
    ("LightingScheme", "byte", "environment preset row"),
    ("ShadowOpacity", "byte", "0-100"),
    ("SunShadows", "byte", "0/1"),
    ("MoonShadows", "byte", "0/1"),
    ("WindPower", "int", "0-2"),
]
LIGHT_COLOR_FIELDS = ["SunAmbientColor", "SunDiffuseColor", "SunFogColor",
                      "MoonAmbientColor", "MoonDiffuseColor", "MoonFogColor"]
# (field, gff type, hint) - all are ambientmusic.2da row indices except MusicDelay
MUSIC_FIELDS = [
    ("MusicDay", "int", "ambientmusic.2da row (0 = none)"),
    ("MusicNight", "int", "ambientmusic.2da row (0 = none)"),
    ("MusicBattle", "int", "ambientmusic.2da row (0 = none)"),
    ("MusicDelay", "byte", "0 = start immediately, 1 = delay day track"),
]
# Area .are "Flags" bitmask (confirmed against nwn-mcp's area-tools.ts and
# sampled area data): bit0 interior, bit1 underground, bit2 natural/outdoor.
AREA_FLAG_INTERIOR = 1
AREA_FLAG_UNDERGROUND = 2
AREA_FLAG_NATURAL = 4

# Stock NWN1 tileset resrefs -> human-readable names (from bin/nwn-wiki,
# reused verbatim). Covers only stock tilesets; haks (e.g. CEP) add custom
# ones not in this table, which correctly fall back to the raw resref.
TILESETS = {
    "tcn01": "City Exterior 1",
    "tcn02": "City Exterior 2",
    "tdc01": "Castle Interior 1",
    "tdc02": "Castle Interior 2",
    "tde01": "Castle Interior, Illuminated",
    "tdm01": "Mines and Caverns",
    "tdr01": "Rural",
    "tds01": "Sewers",
    "tib01": "Beholder Caves",
    "tic01": "City Interior",
    "til01": "Lizardfolk Interior",
    "tin01": "Crypt",
    "tni01": "Mines, Lower",
    "tno01": "Forest",
    "ttd01": "Desert",
    "tte01": "Forest, Drow",
    "ttf01": "Frozen Wastes",
    "ttp01": "Microset",
    "ttr01": "Rural Winter",
    "tts01": "Snow",
    "ttu01": "Underdark",
    "ttz01": "Mountains",
    "twc01": "Castle Exterior, Rural",
}


def tileset_name(resref):
    if not resref:
        return ""
    return TILESETS.get(resref.lower(), resref)


def are_path(root, res):
    return os.path.join(root, res + ".are.json")


def git_path(root, res):
    return os.path.join(root, res + ".git.json")


def area_resrefs(root):
    return sorted(f[:-len(".are.json")] for f in os.listdir(root)
                  if f.endswith(".are.json"))


def area_type_label(flags):
    parts = []
    if flags & AREA_FLAG_NATURAL:
        parts.append("Outside")
    if flags & AREA_FLAG_INTERIOR:
        parts.append("Interior")
    if flags & AREA_FLAG_UNDERGROUND:
        parts.append("Underground")
    return ", ".join(parts) if parts else "(unset)"


def area_row(root, res):
    d = load_cached(are_path(root, res))
    return {
        "res": res,
        "name": loc_get(d, "Name"),
        "tag": getv(d, "Tag", ""),
        "tileset": getv(d, "Tileset", ""),
        "flags": getv(d, "Flags", 0),
        "scripts": {f: getv(d, f, "") for f in AREA_SCRIPT_FIELDS},
    }


def render_areas(root, query):
    q = (query.get("q", [""])[0]).lower()
    tileset = query.get("tileset", [""])[0]
    f_outside = query.get("outside", [""])[0] == "1"
    f_interior = query.get("interior", [""])[0] == "1"
    f_underground = query.get("underground", [""])[0] == "1"
    rows = [area_row(root, r) for r in area_resrefs(root)]
    tilesets = sorted({r["tileset"] for r in rows})
    if q:
        rows = [r for r in rows if q in r["res"].lower()
                or q in r["name"].lower() or q in r["tag"].lower()]
    if tileset:
        rows = [r for r in rows if r["tileset"] == tileset]
    if f_outside:
        rows = [r for r in rows if r["flags"] & AREA_FLAG_NATURAL]
    if f_interior:
        rows = [r for r in rows if r["flags"] & AREA_FLAG_INTERIOR]
    if f_underground:
        rows = [r for r in rows if r["flags"] & AREA_FLAG_UNDERGROUND]
    opts = "".join("<option value='%s'%s>%s</option>" %
                   (esc(t), " selected" if t == tileset else "",
                    esc(tileset_name(t) if t else "(any)"))
                   for t in [""] + tilesets)

    def cb(name, label, checked):
        return ("<label><input type='checkbox' name='%s' value='1'%s> %s</label>" %
                (name, " checked" if checked else "", label))
    filt = ("<form method='get'>Filter: <input type='text' name='q' value='%s'> "
            "Tileset: <select name='tileset'>%s</select> "
            "Type: %s %s %s "
            "<input type='submit' value='Apply filter'></form>"
            "<p class='note'>Type checkboxes narrow the list (all checked "
            "boxes must match); an area can be more than one type "
            "(e.g. an underground cave interior).</p>" %
            (esc(q), opts,
             cb("outside", "Outside", f_outside),
             cb("interior", "Interior", f_interior),
             cb("underground", "Underground", f_underground)))
    # The filter form and "With selected" buttons live in a sticky toolbar
    # pinned above the scrolling table; the buttons use form='areasSelect' to
    # submit the checkbox-selection form below despite being outside it in
    # the DOM (position:sticky can't span the toolbar + table as one block,
    # since the table body needs to scroll underneath both).
    body = [
        "<div class='sticky-toolbar' id='areasToolbar'>", filt,
        "<div class='selected-actions'>With selected: "
        "<button form='areasSelect' name='action' value='scripts'>Edit scripts</button>"
        "<button form='areasSelect' name='action' value='lighting'>Edit lighting/fog</button>"
        "<button form='areasSelect' name='action' value='music'>Edit music</button>"
        "<button form='areasSelect' name='action' value='tags'>Edit tags</button>"
        "<button form='areasSelect' name='action' value='remove_objects'>Remove objects</button>"
        "</div></div>",
        "<form id='areasSelect' method='post' action='%s'>" % purl("/areas/select"),
        "<table class='areas'><thead><tr><th><input type='checkbox' "
        "onclick=\"document.querySelectorAll('input[name=res]')"
        ".forEach(c=>c.checked=this.checked)\"></th>"
        "<th>ResRef</th><th>Name</th><th>Tag</th><th>Tileset</th><th>Type</th>"
        "<th>OnEnter</th><th>OnExit</th><th>OnHeartbeat</th><th>OnUserDefined</th></tr></thead>"
        "<tbody>"]
    for r in rows:
        body.append(
            "<tr><td><input type='checkbox' name='res' value='%s'></td>"
            "<td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td>"
            "<td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>" %
            tuple(esc(x) for x in (
                r["res"], r["res"], r["name"], r["tag"], tileset_name(r["tileset"]),
                area_type_label(r["flags"]),
                r["scripts"]["OnEnter"], r["scripts"]["OnExit"],
                r["scripts"]["OnHeartbeat"], r["scripts"]["OnUserDefined"])))
    body.append("</tbody></table></form>")
    body.append("<p class='note'>%d areas shown.</p>" % len(rows))
    # Keep the sticky table header pinned just below the toolbar rather than
    # under it: measure the toolbar's actual rendered height (its content -
    # filter fields, button count - can wrap differently across browsers/
    # widths, so a fixed offset would drift) and apply it as the thead's
    # sticky top offset.
    body.append(
        "<script>(function(){"
        "var tb=document.getElementById('areasToolbar');"
        "var ths=document.querySelectorAll('table.areas thead th');"
        "function sync(){ if(!tb) return;"
        " var px=tb.offsetHeight+'px';"
        " ths.forEach(function(c){ c.style.top=px; }); }"
        "sync(); window.addEventListener('resize', sync);"
        "})();</script>")
    return page("Areas", "".join(body))


def render_scripts_form(root, resrefs):
    rows = [area_row(root, r) for r in resrefs]
    inputs = "".join(
        "<tr><td>%s</td><td><input type='text' name='%s' placeholder='(leave unchanged)'>"
        "</td><td class='note'>%s</td></tr>" %
        (f, f, esc(", ".join(sorted({r["scripts"][f] or "(none)" for r in rows}))))
        for f in AREA_SCRIPT_FIELDS)
    body = ("<p>Editing <b>%d</b> area(s): %s</p>"
            "<form method='post' action='%s'>%s"
            "<table><tr><th>Event</th><th>New script resref</th>"
            "<th>Current value(s)</th></tr>%s</table>"
            "<p class='note'>Blank = leave unchanged. Enter <b>-</b> to clear "
            "a script. Max 16 chars, no extension.</p>"
            "<input type='submit' value='Apply to selected areas'> "
            "<a class='cancel-link' href='%s'>Cancel</a></form>" %
            (len(resrefs), esc(", ".join(resrefs)), purl("/areas/scripts/apply"),
             hidden_resrefs(resrefs), inputs, purl("/areas")))
    return page("Bulk edit area scripts", body)


def apply_scripts(root, form):
    resrefs, changed = form.get("res", []), []
    for res in resrefs:
        path = are_path(root, res)
        d = json_load(path)
        touched = False
        for f in AREA_SCRIPT_FIELDS:
            val = form.get(f, [""])[0].strip()
            if not val:
                continue
            new = "" if val == "-" else val.lower()[:16]
            if getv(d, f) != new:
                setv(d, f, new, "resref")
                touched = True
        if touched:
            json_save(path, d)
            invalidate(path)
            changed.append(res)
    return result_page("Scripts updated", changed, resrefs)


