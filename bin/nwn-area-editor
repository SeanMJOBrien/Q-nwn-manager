  f.setAttribute("action",base+f.getAttribute("data-console"));});
if(!served){var dir=decodeURIComponent(location.pathname).replace(/\\/[^\\/]*$/,"");
  if(dir)document.getElementById("repodir").textContent=" ("+dir+")";}
fetch(base+"/api/root-mods").then(function(r){return r.json();}).then(function(d){
