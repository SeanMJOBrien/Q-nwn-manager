            (purl("/areas/tags/apply"), hidden_resrefs(resrefs), "".join(rows),
             purl("/areas")))
    return page("Edit area tags / resrefs", body)


def apply_tags(root, git_root, gic_root, form):
    resrefs, changed, errors = form.get("res", []), [], []
    for res in resrefs:
        path = are_path(root, res)
        d = json_load(path)
        touched = False
        new_tag = form.get("tag_" + res, [""])[0].strip()
        if new_tag and new_tag != getv(d, "Tag"):
            setv(d, "Tag", new_tag, "cexostring")
            touched = True
        new_ref = form.get("ref_" + res, [""])[0].strip().lower()
        if new_ref and new_ref != res:
            if not re.fullmatch(r"[a-z0-9_]{1,16}", new_ref):
                errors.append("%s: invalid resref %r" % (res, new_ref))
                new_ref = ""
            elif os.path.exists(are_path(root, new_ref)):
                errors.append("%s: %r already exists" % (res, new_ref))
                new_ref = ""
        else:
            new_ref = ""
        if new_ref:
            setv(d, "ResRef", new_ref, "resref")
            touched = True
        if touched:
            json_save(path, d)
            invalidate(path)
            changed.append(res)
        if new_ref:
            for base, ext in ((root, ".are.json"), (git_root, ".git.json"),
                               (gic_root, ".gic.json")):
                old_p = os.path.join(base, res + ext)
                if os.path.exists(old_p):
                    os.replace(old_p, os.path.join(base, new_ref + ext))
                    invalidate(old_p)
    extra = "".join("<p class='err'>%s</p>" % esc(e) for e in errors)
    return result_page("Tags updated", changed, resrefs, extra)


def result_page(title, changed, selected, extra=""):
    body = ("<p class='ok'>Changed %d of %d selected: %s</p>%s"
            "<p><a href='%s'>Back to areas</a></p>" %
            (len(changed), len(selected),
             esc(", ".join(changed) or "(nothing - all values blank/same)"),
             extra, purl("/areas")))
    return page(title, body)


# --- Remove placed objects (creatures/placeables/loose items + their -------
#     nested inventory) from selected areas' .git.json -----------------------
# Top-level placed-object list fields, keyed by a short URL-safe category
# name. Field name spacing is genuinely inconsistent in GFF-JSON ("Creature
# List" / "Placeable List" are spaced, bare "List" holds loose ground items)
# - that's the real shape, not a typo to fix.
OBJECT_LIST_FIELDS = {
    "creature": "Creature List",
    "placeable": "Placeable List",
    "item": "List",
}

# Nested inventory fields per top-level category. Loose items have no
# inventory of their own here, so "item" is intentionally absent.
INVENTORY_SUBFIELDS = {
    "creature": [("Equip_ItemList", "Equipped"), ("ItemList", "Carried")],
    "placeable": [("ItemList", "Carried")],
}


def _obj_position(entry):
    x = getv(entry, "X", getv(entry, "XPosition", 0.0))
    y = getv(entry, "Y", getv(entry, "YPosition", 0.0))
    return x, y


def _inventory_rows_html(res, category, idx, entry):
    rows = []
    for subfield, label in INVENTORY_SUBFIELDS.get(category, []):
        items = getv(entry, subfield, [])
        for sub_idx, item in enumerate(items):
            resref = getv(item, "EquippedRes", getv(item, "InventoryRes", ""))
            where = label
            if subfield == "Equip_ItemList":
                slot_id = item.get("__struct_id", 0)
                where = "%s (%s)" % (label, EQUIP_SLOT_NAMES.get(
                    slot_id, "Slot %s" % slot_id))
            cb_value = "|".join((res, category, str(idx), subfield, str(sub_idx)))
            rows.append(
                "<tr><td><input type='checkbox' name='del' value='%s'></td>"
                "<td colspan='3'>%s: %s</td></tr>" %
                (esc(cb_value), esc(where), esc(resref)))
    if not rows:
        return ""
    return ("<tr><td></td><td colspan='3'><table class='nested'>%s</table>"
            "</td></tr>" % "".join(rows))


def render_remove_objects_form(root, git_root, resrefs):
    sections = []
    for res in resrefs:
        path = git_path(git_root, res)
        if not os.path.isfile(path):
            continue
        g = load_cached(path)
        area_rows = []
        for category, field in OBJECT_LIST_FIELDS.items():
            entries = getv(g, field, [])
            for idx, entry in enumerate(entries):
                tag = getv(entry, "Tag", "")
                blueprint = getv(entry, "TemplateResRef", "")
                x, y = _obj_position(entry)
                cb_value = "|".join((res, category, str(idx)))
                area_rows.append(
                    "<tr><td><input type='checkbox' name='del' value='%s'></td>"
                    "<td>%s</td><td>%s</td><td>%s</td><td>%.1f, %.1f</td></tr>" %
                    (esc(cb_value), esc(category), esc(tag), esc(blueprint), x, y))
                area_rows.append(_inventory_rows_html(res, category, idx, entry))
        area_rows = [r for r in area_rows if r]
        if not area_rows:
            continue
        sections.append(
            "<h3>%s</h3><table><tr><th></th><th>Type</th><th>Tag</th>"
            "<th>Blueprint</th><th>Position</th></tr>%s</table>" %
            (esc(res), "".join(area_rows)))

    if not sections:
        return page("Remove placed objects",
                    "<p class='note'>No placeables, creatures, or loose "
                    "items found in the selected area(s).</p>"
                    "<p><a href='%s'>Back</a></p>" % purl("/areas"))

    body = ("<form method='post' action='%s'>%s%s"
            "<p class='note'>Tick objects to REMOVE, then Apply. First edit "
            "of each area keeps a one-time .git.json.bak backup, but this is "
            "otherwise permanent - review before applying.</p>"
            "<input type='submit' value='Remove selected'> "
            "<a class='cancel-link' href='%s'>Cancel</a></form>" %
            (purl("/areas/objects/apply"), hidden_resrefs(resrefs),
             "".join(sections), purl("/areas")))
    return page("Remove placed objects", body)


def apply_remove_objects(root, git_root, form):
    resrefs = form.get("res", [])
    top_doomed = defaultdict(set)
    nested_doomed = defaultdict(set)
    for val in form.get("del", []):
        parts = val.split("|")
        if len(parts) == 3:
            res, category, idx_s = parts
            if res in resrefs and category in OBJECT_LIST_FIELDS:
                top_doomed[(res, category)].add(int(idx_s))
        elif len(parts) == 5:
            res, category, idx_s, subfield, sub_s = parts
            if res in resrefs and category in OBJECT_LIST_FIELDS:
                nested_doomed[(res, category, int(idx_s), subfield)].add(int(sub_s))

    changed = []
    for res in resrefs:
        path = git_path(git_root, res)
        if not os.path.isfile(path):
            continue
        g = json_load(path)
        touched = False

        # Nested removals first: filter a container entry's own sub-list in
        # place. If that same container is also doomed at the top level, the
        # whole entry disappears next anyway, so order doesn't matter.
        for (nres, category, idx, subfield), sub_idx_set in nested_doomed.items():
            if nres != res:
                continue
            entries = getv(g, OBJECT_LIST_FIELDS[category], [])
            if idx >= len(entries):
                continue
            container = entries[idx]
            items = getv(container, subfield, [])
            kept = [it for i, it in enumerate(items) if i not in sub_idx_set]
            if len(kept) != len(items):
                setv(container, subfield, kept, "list")
                touched = True

        for category, field in OBJECT_LIST_FIELDS.items():
            idx_set = top_doomed.get((res, category))
            if not idx_set:
                continue
            entries = getv(g, field, [])
            kept = [e for i, e in enumerate(entries) if i not in idx_set]
            if len(kept) != len(entries):
                setv(g, field, kept, "list")
                touched = True

        if touched:
            json_save(path, g)
            invalidate(path)
            changed.append(res)
    return result_page("Objects removed", changed, resrefs)


# --- Area map (ported from skills/nwn-web-editor/scripts/nwn_area_map.py) ---
# Self-contained, pan/zoomable interactive SVG map of a project's areas, laid
# out by the cardinal directions implied by door/trigger/waypoint transitions.
#
# How directions are inferred: every door/trigger transition knows where it
# sits inside its source area and where its destination (door or waypoint
# tag) sits inside the target area. An exit near the source's north edge that
# lands near the destination's south edge votes "destination is north of
# source". Votes for all transitions between a pair are averaged into one
# cardinal.
#
# Layout: each connected component is laid out independently (BFS from its
# best-connected area, stepping one grid cell per cardinal), then components
# are shelf-packed side by side so unjoined groups get their own region of
# the map. When two areas contend for the same grid cell, an underground area
# may share the cell with a surface area as a second layer; same-layer
# collisions probe further along the cardinal instead.

def read_module_map(root, git_root):
    """JSON-native area/transition reader for the map (reads <res>.are.json /
    <res>.git.json via load_cached() - no nwn_gff subprocess). Returns
    (areas, transitions):
      areas[res] = {name, tag, underground, w, h (meters)}
      transitions = [(src_res, dst_res, dirvec (dx,dy) normalized-ish)]
    """
    areas = {}
    exits = []           # (src_res, linked_to_tag, x, y)
    tag_landing = {}     # dest tag -> (area_res, x, y); doors + waypoints
    for res in area_resrefs(root):
        a = load_cached(are_path(root, res))
        areas[res] = {
            "name": loc_get(a, "Name") or res,
            "tag": getv(a, "Tag", ""),
            "underground": bool(getv(a, "Flags", 0) & AREA_FLAG_UNDERGROUND),
            "w": getv(a, "Width", 8) * 10.0,
            "h": getv(a, "Height", 8) * 10.0,
        }
        gpath = git_path(git_root, res)
        if not os.path.isfile(gpath):
            continue
        g = load_cached(gpath)
        for door in getv(g, "Door List", []):
            x, y = getv(door, "X", 0.0), getv(door, "Y", 0.0)
            tag = getv(door, "Tag", "")
            if tag:
                tag_landing.setdefault(tag, (res, x, y))
            link = getv(door, "LinkedTo", "")
            if link and getv(door, "LinkedToFlags", 0):
                exits.append((res, link, x, y))
        for trig in getv(g, "TriggerList", []):
            link = getv(trig, "LinkedTo", "")
            if link and getv(trig, "LinkedToFlags", 0):
                exits.append((res, link,
                              getv(trig, "XPosition", 0.0),
                              getv(trig, "YPosition", 0.0)))
        for wp in getv(g, "WaypointList", []):
            tag = getv(wp, "Tag", "")
            if tag:
                tag_landing.setdefault(tag, (res,
                                             getv(wp, "XPosition", 0.0),
                                             getv(wp, "YPosition", 0.0)))

    transitions = []
    for src, link, x, y in exits:
        hit = tag_landing.get(link)
        if not hit or hit[0] == src or hit[0] not in areas:
            continue
        dst, dx_land, dy_land = hit
        sa, da = areas[src], areas[dst]
        # normalized offsets from each area's center, range about [-0.5, 0.5];
        # NWN Y grows northward, so +y already means north.
        exit_off = (x / sa["w"] - 0.5, y / sa["h"] - 0.5)
        entry_off = (dx_land / da["w"] - 0.5, dy_land / da["h"] - 0.5)
        transitions.append((src, dst,
                            (exit_off[0] - entry_off[0],
                             exit_off[1] - entry_off[1])))
    return areas, transitions


def build_edges(transitions):
    """Collapse raw transitions into one edge per unordered pair.

    Returns edges[(a, b)] = {"vec": (dx, dy) meaning b relative to a,
                             "two_way": bool}
    """
    votes = defaultdict(list)
    for src, dst, vec in transitions:
        votes[(src, dst)].append(vec)
    edges = {}
    for (src, dst), vs in votes.items():
        if (dst, src) in edges:
            e = edges[(dst, src)]
            e["two_way"] = True
            # fold reverse-direction votes in, flipped
            n = len(vs)
            e["vec"] = (e["vec"][0] - sum(v[0] for v in vs) / n,
                        e["vec"][1] - sum(v[1] for v in vs) / n)
            continue
        n = len(vs)
        edges[(src, dst)] = {
            "vec": (sum(v[0] for v in vs) / n, sum(v[1] for v in vs) / n),
            "two_way": False,
        }
    return edges


def grid_step(vec):
    """Vote vector -> grid step (each axis in {-1,0,1}, diagonals allowed).
    Grid Y grows SOUTH (screen coordinates), NWN Y grows north - flip here,
    once. An axis only contributes if it's a meaningful share of the vote."""
    dx, dy = vec
    m = max(abs(dx), abs(dy))
    if m == 0:
        return (1, 0)
    sx = 0 if abs(dx) < 0.4 * m else (1 if dx > 0 else -1)
    sy = 0 if abs(dy) < 0.4 * m else (-1 if dy > 0 else 1)
    return (sx, sy) if (sx, sy) != (0, 0) else (1, 0)


def components(areas, edges):
    adj = defaultdict(set)
    for a, b in edges:
        adj[a].add(b)
        adj[b].add(a)
    seen, comps = set(), []
    for res in areas:
        if res in seen:
            continue
        stack, comp = [res], []
        seen.add(res)
        while stack:
            cur = stack.pop()
            comp.append(cur)
            for nb in adj[cur]:
                if nb not in seen:
                    seen.add(nb)
                    stack.append(nb)
        comps.append(comp)
    comps.sort(key=len, reverse=True)
    return comps, adj


def layout_component(comp, areas, edges, adj):
    """Place each area of one component on an integer grid. Returns
    pos[res] = (gx, gy). Underground and surface areas may share a cell."""
    step_of = {}
    for (a, b), e in edges.items():
        sx, sy = grid_step(e["vec"])
        step_of[(a, b)] = (sx, sy)
        step_of[(b, a)] = (-sx, -sy)

    occupied = {}   # (gx, gy, layer) -> res
    pos = {}

    def layer(res):
        return 1 if areas[res]["underground"] else 0

    def place(res, gx, gy, from_cell=None):
        """Claim the free cell nearest to the ideal (gx, gy). A cell only
        conflicts within the same layer, so an underground area stacks onto
        a surface area's cell - that's the requested layering. When probing,
        prefer cells that keep the same compass side of the parent cell."""
        lay, ring_step = layer(res), 0
        while True:
            ring = [(gx, gy)] if ring_step == 0 else [
                (gx + ox, gy + oy)
                for ox in range(-ring_step, ring_step + 1)
                for oy in range(-ring_step, ring_step + 1)
                if max(abs(ox), abs(oy)) == ring_step]
            free = [c for c in ring if (c[0], c[1], lay) not in occupied]
            if free:
                if from_cell:
                    fx, fy = from_cell
                    want = (gx - fx, gy - fy)
                    # keep the direction from the parent: penalize sign flips
                    free.sort(key=lambda c: (
                        (0 if (c[0] - fx) * want[0] >= 0 else 1) +
                        (0 if (c[1] - fy) * want[1] >= 0 else 1),
                        (c[0] - gx) ** 2 + (c[1] - gy) ** 2))
                cx, cy = free[0]
                occupied[(cx, cy, lay)] = res
                pos[res] = (cx, cy)
                return
            ring_step += 1

    start = max(comp, key=lambda r: len(adj[r]))
    place(start, 0, 0)
    queue = [start]
    while queue:
        cur = queue.pop(0)
        cx, cy = pos[cur]
        for nb in sorted(adj[cur]):
            if nb in pos:
                continue
            dx, dy = step_of.get((cur, nb), (1, 0))
            place(nb, cx + dx, cy + dy, from_cell=(cx, cy))
            queue.append(nb)
    return pos


def layout_module(areas, edges):
    """Full layout: big components shelf-packed left to right, then all
    singleton (unjoined) areas in their own dense block below."""
    comps, adj = components(areas, edges)
    multi = [c for c in comps if len(c) > 1]
    singles = [c[0] for c in comps if len(c) == 1]

    placed = {}      # res -> (gx, gy) global grid
    comp_id = {}
    shelf_x, shelf_y, shelf_h = 0, 0, 0
    total_cells = sum(len(c) for c in multi) or 1
    max_row_w = max(12, int(total_cells ** 0.5 * 2.2))
    boxes = []       # (label, gx0, gy0, gx1, gy1)

    for idx, comp in enumerate(multi):
        pos = layout_component(comp, areas, edges, adj)
        xs = [p[0] for p in pos.values()]
        ys = [p[1] for p in pos.values()]
        w, h = max(xs) - min(xs) + 1, max(ys) - min(ys) + 1
        if shelf_x > 0 and shelf_x + w > max_row_w:
            shelf_x, shelf_y, shelf_h = 0, shelf_y + shelf_h + 2, 0
        ox, oy = shelf_x - min(xs), shelf_y - min(ys)
        for res, (gx, gy) in pos.items():
            placed[res] = (gx + ox, gy + oy)
            comp_id[res] = idx
        boxes.append(("Region %d (%d areas)" % (idx + 1, len(comp)),
                      shelf_x, shelf_y, shelf_x + w - 1, shelf_y + h - 1))
        shelf_x += w + 2
        shelf_h = max(shelf_h, h)

    # singles block
    if singles:
        sy0 = shelf_y + shelf_h + 3
        per_row = max(8, max_row_w)
        for i, res in enumerate(sorted(singles)):
            placed[res] = (i % per_row, sy0 + i // per_row)
            comp_id[res] = -1
        boxes.append(("Unconnected areas (%d)" % len(singles),
                      0, sy0, per_row - 1, sy0 + (len(singles) - 1) // per_row))
    return placed, comp_id, boxes


MAP_CELL_W, MAP_CELL_H = 190, 140
MAP_NODE_W, MAP_NODE_H = 158, 84
MAP_UG_OFF = 18  # px offset for underground node sharing a cell


def node_xy(placed, areas, res):
    gx, gy = placed[res]
    x = gx * MAP_CELL_W + (MAP_CELL_W - MAP_NODE_W) / 2
    y = gy * MAP_CELL_H + (MAP_CELL_H - MAP_NODE_H) / 2
    if areas[res]["underground"]:
        x += MAP_UG_OFF
        y += MAP_UG_OFF
    return x, y


def render_svg(areas, edges, placed, boxes):
    parts = []
    # region boxes first (bottom of stack)
    for label, gx0, gy0, gx1, gy1 in boxes:
        x, y = gx0 * MAP_CELL_W - 12, gy0 * MAP_CELL_H - 12
        w = (gx1 - gx0 + 1) * MAP_CELL_W + 24
        h = (gy1 - gy0 + 1) * MAP_CELL_H + 24 + MAP_UG_OFF
        parts.append(
            "<rect class='region' x='%d' y='%d' width='%d' height='%d' rx='14'/>"
            "<text class='regionlabel' x='%d' y='%d'>%s</text>"
            % (x, y, w, h, x + 10, y - 4, esc(label)))
    # edges
    for (a, b), e in edges.items():
        ax, ay = node_xy(placed, areas, a)
        bx, by = node_xy(placed, areas, b)
        ax += MAP_NODE_W / 2
        ay += MAP_NODE_H / 2
        bx += MAP_NODE_W / 2
        by += MAP_NODE_H / 2
        cls = "edge"
        if areas[a]["underground"] != areas[b]["underground"]:
            cls += " crosslayer"
        marker = "" if e["two_way"] else " marker-end='url(#arrow)'"
        parts.append(
            "<line class='%s' x1='%.0f' y1='%.0f' x2='%.0f' y2='%.0f'%s>"
            "<title>%s %s %s%s</title></line>"
            % (cls, ax, ay, bx, by, marker, esc(a),
               "&#8596;" if e["two_way"] else "&#8594;", esc(b),
               " (cross-layer)" if "crosslayer" in cls else ""))
    # nodes
    for res in placed:
        a = areas[res]
        x, y = node_xy(placed, areas, res)
        cls = "node ug" if a["underground"] else "node surface"
        name = a["name"] if len(a["name"]) <= 26 else a["name"][:25] + "…"
        parts.append(
            "<g class='%s' data-name='%s' data-res='%s'>"
            "<rect x='%.0f' y='%.0f' width='%d' height='%d' rx='8'/>"
            "<text x='%.0f' y='%.0f'>%s</text>"
            "<text class='res' x='%.0f' y='%.0f'>%s%s</text>"
            "<title>%s\nresref: %s\ntag: %s\n%s</title></g>"
            % (cls, esc(a["name"].lower()), esc(res),
               x, y, MAP_NODE_W, MAP_NODE_H,
               x + MAP_NODE_W / 2, y + 34, esc(name),
               x + MAP_NODE_W / 2, y + 58, esc(res),
               " ▼" if a["underground"] else "",
               esc(a["name"]), esc(res), esc(a["tag"]),
               "underground" if a["underground"] else "surface"))
    max_x = max(gx for gx, _ in placed.values()) + 1
    max_y = max(gy for _, gy in placed.values()) + 1
    return "\n".join(parts), max_x * MAP_CELL_W + 40, max_y * MAP_CELL_H + 60


