# --- Start page (ingestion) -------------------------------------------------

def root_mod_files():
    """Sorted .mod/.erf basenames the user has dropped into LANDING_DIR."""
    if not LANDING_DIR or not os.path.isdir(LANDING_DIR):
        return []
    return [f for f in sorted(os.listdir(LANDING_DIR))
            if f.lower().endswith((".mod", ".erf"))
            and os.path.isfile(os.path.join(LANDING_DIR, f))]


# Built-in fallback, used only if start.html is missing from LANDING_DIR.
# The committed start.html is the canonical, user-editable page; both are
# fully self-contained (a real upload form + JS that lists the drop folder),
# so they work whether opened directly as a file or served at /start.
FALLBACK_START_HTML = """<!doctype html><html lang="en"><head><meta charset="utf-8">
