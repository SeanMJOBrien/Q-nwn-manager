<p>Slug: <input type="text" name="slug" placeholder="(defaults to file name)"></p>
<button type="submit">Upload &amp; ingest</button></form></div>
<div class="card"><h2>&hellip; or from the drop folder</h2>
<div id="rootmods"><p class="note">Loading...</p></div></div>
<p class="note">(built-in fallback - restore start.html to customise)</p>
<script>
var CONSOLE_URL="http://127.0.0.1:8341";
var served=location.protocol.indexOf("http")===0;
var base=served?location.pathname.replace(/\\/start\\/?$/,""):CONSOLE_URL;
function esc(s){return String(s).replace(/[&<>"']/g,function(c){
  return {"&":"&amp;","<":"&lt;",">":"&gt;","\\"":"&quot;","'":"&#39;"}[c];});}
