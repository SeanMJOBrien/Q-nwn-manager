#!/usr/bin/env python3
"""nwn-console - stdlib-only multi-project web console for NWN:EE modules.

Home page (dashboard) lets you:
  - UPLOAD a .mod (+ optional loose files) -> ingested into a new project
    (its own subdirectory under --projects-dir) via `nwn-manager init`
  - per project: REBUILD the project-specific wiki (`nwn-manager wiki`)
  - per project: BUILD & DOWNLOAD the packed .mod (`nwn-manager repack`)
  - per project: bulk-edit areas (event scripts, lighting/fog, tags/resrefs)

Each project is a nasher project dir (nasher.cfg + unpacked/*.are.json ...),
managed, viewed, and built independently. Long operations (build ~minutes,
wiki ~30s, ingest) run as background jobs with a live-progress page.

This is the JSON-native evolution of the old nwn-area-editor: it reads/writes
the GFF-as-JSON documents nwn-manager keeps under version control
(<resref>.are.json, produced by `nwn-manager unpack` / nwn_gff -k json), so no
per-file nwn_gff round-trips are needed.

Modes:
  Multi-project (console):  --projects-dir DIR   (dashboard at /, /p/<slug>/...)
  Legacy single-dir:        --dir DIR            (area editor only, no prefix)

Safety:
  - binds 127.0.0.1 only (use --host to override deliberately)
  - first edit of any file writes a one-time <file>.json.bak sibling backup
  - only submitted, non-blank fields are changed; everything else round-trips
    byte-identically (plain JSON load/dump, no GFF conversion involved)
  - static wiki + download file serving is path-traversal guarded

Usage:
  nwn-manager console [--projects-dir DIR] [--port 8341] [--url-prefix /qedit]
  python3 nwn-area-editor --dir /path/to/unpacked   # legacy single-project
"""

import argparse
import glob
import html
import json
import mimetypes
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
import uuid
from collections import defaultdict
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

# --- Runtime config (set in main) -------------------------------------------

PROJECTS_DIR = None    # multi-project root (None in legacy single-dir mode)
SINGLE_MODE = False     # True when launched with --dir instead of --projects-dir
SINGLE_PROJECT = None   # the implicit Project in single-dir mode
NWN_MANAGER = None      # path to the nwn-manager wrapper (for init/unpack/wiki/repack)
LANDING_DIR = None      # where start.html lives and dropped .mod files are scanned
SERVER = None           # the ThreadingHTTPServer (for the /shutdown "Stop" button)

# Per-request context (ThreadingHTTPServer gives one thread per request).
_req = threading.local()


def _slug():
    return getattr(_req, "slug", None)


def _proxy():
    return getattr(_req, "proxy", "")


def purl(path=""):
    """Absolute in-app URL for the current project (or plain, in single mode)."""
    base = _proxy()
    if _slug():
        base += "/p/" + _slug()
    return (base + path) or "/"


def gurl(path=""):
    """Absolute in-app URL at the console root (dashboard/jobs), proxy-aware."""
    return (_proxy() + path) or "/"


# --- JSON GFF plumbing -------------------------------------------------------

# Cache: path -> (mtime, data). Avoids a reparse per file per page load.
_CACHE = {}


def json_load(path):
    with open(path) as fh:
        return json.load(fh)


def json_save(path, data):
    """Write GFF-as-JSON, with one-time .bak backup and atomic replace."""
    bak = path + ".bak"
    if os.path.exists(path) and not os.path.exists(bak):
        shutil.copy2(path, bak)
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, path)


def load_cached(path):
    mtime = os.path.getmtime(path)
    hit = _CACHE.get(path)
    if hit and hit[0] == mtime:
        return hit[1]
    data = json_load(path)
    _CACHE[path] = (mtime, data)
    return data


def invalidate(path):
    _CACHE.pop(path, None)


# --- GFF field helpers (same shape as nwn_web_editor.py) --------------------

def getv(d, name, default=None):
    f = d.get(name)
    return f["value"] if isinstance(f, dict) and "value" in f else default


def setv(d, name, value, gff_type=None):
    """Set a field, preserving its existing declared type when present."""
    if name in d and isinstance(d[name], dict) and "type" in d[name]:
        d[name]["value"] = value
    elif gff_type:
        d[name] = {"type": gff_type, "value": value}
    else:
        raise KeyError("field %r absent and no type given" % name)


def loc_get(d, name):
    """First inline text of a CExoLocString ('' if TLK-only or absent)."""
    v = getv(d, name)
    if isinstance(v, dict):
        for k, txt in v.items():
            if k != "id" and isinstance(txt, str):
                return txt
    return ""


def loc_set(d, name, text):
    f = d.get(name)
    if not (isinstance(f, dict) and isinstance(f.get("value"), dict)):
        d[name] = {"type": "cexolocstring", "value": {}}
        f = d[name]
    f["value"]["0"] = text


def dword_to_hex(v):
    """NWN color dword (0xBBGGRR) -> '#rrggbb'."""
    return "#%02x%02x%02x" % (v & 0xFF, (v >> 8) & 0xFF, (v >> 16) & 0xFF)


def hex_to_dword(s):
    s = s.lstrip("#")
    r, g, b = int(s[0:2], 16), int(s[2:4], 16), int(s[4:6], 16)
    return r | (g << 8) | (b << 16)


# --- HTML helpers -----------------------------------------------------------

def esc(s):
    return html.escape(str(s), quote=True)


