#!/usr/bin/env bash
set -Eeuo pipefail
trap 'echo "[nwn-manager] ERROR at line $LINENO in ${FUNCNAME[0]:-main}: $BASH_COMMAND (exit $?)" >&2' ERR

# nwn-manager — multi-module manager for NWN1 .mod files (git-friendly,
# LLM-editable workflow). Thin wrapper around nasher (squattingmonk/nasher)
# and the neverwinter.nim CLIs (niv/neverwinter.nim).

PROG=$(basename "$0")
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

# Make external tools discoverable as a PATH fallback, so nasher / nwn_gff /
# nwn_erf / nwnsc are found even when the launching shell's PATH lacks them
# (common when the console is started from a GUI or a minimal shell). We add:
#   1) a bundled nwn-tools dir - $NWN_TOOLS_DIR, or the sibling of the repo -
#      laid out as <root>/<platform>/{nasher,neverwinter,nwnsc,...}
#   2) the usual Nim install bin dirs (~/.nimble/bin, ~/.local/bin)
case "$(uname -s 2>/dev/null)" in
  Darwin) _plat=macos_arm64 ;;
  Linux)  _plat=linux ;;
  MINGW*|MSYS*|CYGWIN*) _plat=win ;;
  *)      _plat="" ;;
esac
# Check, in order: an explicit $NWN_TOOLS_DIR, the tools bundled IN this repo
# (bin/../nwn-tools), then a shared nwn-tools sibling of the repo. win uses
# a "neverwinter64" subdir; the others use "neverwinter".
if [[ -n ${_plat:-} ]]; then
  for _root in "${NWN_TOOLS_DIR:-}" "$SCRIPT_DIR/../nwn-tools" "$SCRIPT_DIR/../../nwn-tools"; do
    [[ -n $_root && -d "$_root/$_plat" ]] || continue
    for _d in nasher neverwinter neverwinter64 nwnsc sqlite; do
      [[ -d "$_root/$_plat/$_d" ]] && PATH="$PATH:$_root/$_plat/$_d"
    done
  done
fi
# $NWN_TOOLS_DIR may also point straight at a flat directory of binaries.
[[ -n ${NWN_TOOLS_DIR:-} && -d "${NWN_TOOLS_DIR:-}" ]] && PATH="$PATH:$NWN_TOOLS_DIR"
for _d in "$HOME/.nimble/bin" "$HOME/.local/bin"; do
  [[ -d "$_d" ]] && PATH="$PATH:$_d"
done
export PATH
unset _root _plat _d 2>/dev/null || true

# Locate a compiled nwn-pytools binary (built from bin/_pytools_main.py via
# build/nwn-pytools.spec) under the same nwn-tools/<platform>/ convention
# used above for nasher/nwn_gff/nwnsc, so wiki/console/edit-areas/serve and
# the repack dlg-check gate can run without python3 installed. Empty when
# none is found - run_pytool()/run_pytool_exec() below fall back to today's
# `python3 <script>` behavior in that case.
PYTOOLS_BIN=""
case "$(uname -s 2>/dev/null)" in
  Darwin) _pt_plat=macos_arm64; _pt_exe="" ;;
  Linux)  _pt_plat=linux; _pt_exe="" ;;
  MINGW*|MSYS*|CYGWIN*) _pt_plat=win; _pt_exe=".exe" ;;
  *)      _pt_plat=""; _pt_exe="" ;;
esac
if [[ -n ${_pt_plat:-} ]]; then
  for _pt_root in "${NWN_TOOLS_DIR:-}" "$SCRIPT_DIR/../nwn-tools" "$SCRIPT_DIR/../../nwn-tools"; do
    [[ -n $_pt_root ]] || continue
    _pt_cand="$_pt_root/$_pt_plat/nwn-pytools/nwn-pytools$_pt_exe"
    if [[ -x $_pt_cand ]]; then
      PYTOOLS_BIN=$_pt_cand
      break
    fi
  done
fi
export PYTOOLS_BIN
unset _pt_plat _pt_root _pt_cand _pt_exe 2>/dev/null || true

# Run a Python-based subcommand in the foreground, preserving stdout/
# stderr/exit code: prefer the compiled nwn-pytools binary when found, else
# fall back to running the real script under python3 (or, for the two
# dispatcher-only lookups with no standalone script, under the dispatcher
# source file itself). $1 = subcommand name (wiki/area-editor/wiki-activity/
# check-dlg-integrity/hak-list/tlk-name); remaining args passed through.
run_pytool() {
  local sub=$1; shift
  if [[ -n $PYTOOLS_BIN ]]; then
    "$PYTOOLS_BIN" "$sub" "$@"
  elif [[ $sub == check-dlg-integrity ]]; then
    "$SCRIPT_DIR/check-dlg-integrity" "$@"
  elif [[ $sub == hak-list || $sub == tlk-name ]]; then
    python3 "$SCRIPT_DIR/_pytools_main.py" "$sub" "$@"
  else
    python3 "$SCRIPT_DIR/nwn-$sub" "$@"
  fi
}

# Same as run_pytool but tail-calls via exec (process replacement) instead
# of running in the foreground - for cmd_wiki/cmd_console/cmd_edit_areas,
# which only ever invoke one of the nwn-$sub-named scripts.
run_pytool_exec() {
  local sub=$1; shift
  if [[ -n $PYTOOLS_BIN ]]; then
    exec "$PYTOOLS_BIN" "$sub" "$@"
  else
    exec python3 "$SCRIPT_DIR/nwn-$sub" "$@"
  fi
}

usage() {
  cat <<EOF
$PROG — multi-module manager for NWN1 .mod files.

Usage:
  $PROG init <project-dir> <module.mod>
                          Create a new module project. Initializes
                          nasher.cfg, populates <dir>/unpacked/ from
                          <module.mod>, writes .gitignore and a stub
                          README.md.

  $PROG unpack [<module.mod>]
                          Refresh ./unpacked/ from the .mod. With no
                          argument, re-unpacks the path stored in
                          .nasher/source. Run from inside a project
                          (or any subdir).

  $PROG repack [args...]  Build .mod from ./unpacked/ via 'nasher
                          pack'. If a path is recorded in
                          .nasher/source, copy the built .mod there.
                          Extra args pass through to nasher.

  $PROG wiki [--out <dir>] [args...]
                          Generate a static HTML wiki from
                          ./unpacked/ into <project>/docs/ (or --out).
                          docs/ is the folder GitHub Pages publishes
                          from. Extra args pass through to nwn-wiki.

  $PROG console [--projects-dir <dir>] [args...]
                          Serve the multi-project web console: a home page to
                          upload/ingest a .mod into a new project, rebuild its
                          wiki, build & download the packed .mod, and bulk-edit
                          areas. Each project lives in its own subdirectory
                          under --projects-dir (default: <repo>/projects).
                          Extra args pass through to the console (--port,
                          --host, --url-prefix, --wiki-shell, --wiki-base, --nav).

  $PROG edit-areas [--dir <dir>] [args...]
                          Serve a local web UI for bulk-editing area event
                          scripts, lighting/fog, and tags/resrefs directly
                          against ./unpacked/*.are.json (or --dir). Extra
                          args pass through to nwn-area-editor (--port,
                          --url-prefix, --wiki-shell, --wiki-base, --nav).

  $PROG serve --log-dir <dir> [options]
                          Monitor player activity via NWN server logs.
                          Polls every 5 minutes (configurable). When
                          the last player leaves, optionally refreshes
                          activity.html and publishes it to git.

                          Options:
                            --log-dir <dir>        NWN server log dir
                                                   (repeat for multiple)
                            --poll-interval <min>  Check interval in
                                                   minutes (default: 5)
                            --auto-publish         On player session end:
                                                   refresh activity.html
                                                   (and ServerFirsts.html
                                                   if --db-dir set),
                                                   git commit, and push
                            --activity-cache <path> JSON session cache
                                                   (default: first
                                                   log-dir/activity-
                                                   sessions.json)
                            --db-dir <dir>         Campaign database dir
                                                   (bestiarydb.sqlite3).
                                                   Refreshes ServerFirsts
                                                   page alongside activity
                            --backup-cmd <cmd>     Command to run at each idle
                                                   moment (no players online).
                                                   Expected to self-gate (e.g.
                                                   once/day); used to snapshot
                                                   server state opportunistically

  $PROG -h | --help       Show this help.

Per-project layout (created by 'init'):
  nasher.cfg     project + target config (committed)
  unpacked/      source tree of GFF JSON + .nss scripts (committed)
  dist/          packed .mod output (gitignored)
  docs/          generated wiki — committed; GitHub Pages serves from here
  .nasher/       nasher cache + last-used source path (gitignored)

Prerequisites (must be on PATH):
  nasher              — nimble install nasher
  nwn_gff, nwn_erf    — nimble install neverwinter
  nwnsc               — bundled in nwn-tools/<platform>/nwnsc/, or
                         squattingmonk/nwnsc release (used by 'repack' to
                         compile scripts on all platforms)
  python3             — for 'wiki' and 'console' subcommands
EOF
}

# Verify required external CLIs are available; print install hints if not.
# Portable to bash 3.2 (macOS system bash) - no associative arrays.
preflight() {
  local missing=0 bin hint
  for bin in "$@"; do
    if ! command -v "$bin" >/dev/null 2>&1; then
      case "$bin" in
        nasher)                   hint="nimble install nasher" ;;
        nwn_gff|nwn_erf|nwn_script_comp) hint="nimble install neverwinter" ;;
        nwnsc)                    hint="bundled in nwn-tools/<platform>/nwnsc/, or squattingmonk/nwnsc release" ;;
        python3)                  hint="install Python 3 (system package)" ;;
        *)                        hint="" ;;
      esac
      echo "error: required tool '$bin' not on PATH" >&2
      [[ -n "$hint" ]] && echo "       install with: $hint" >&2
      missing=1
    fi
  done
  [[ $missing -eq 0 ]] || exit 1
}

# Walk up from cwd to find a directory containing nasher.cfg.
# Echoes the directory on success, returns 1 if not found.
find_project_root() {
  local d=$PWD
  while [[ $d != "/" ]]; do
    if [[ -f "$d/nasher.cfg" ]]; then
      echo "$d"
      return 0
    fi
    d=$(dirname "$d")
  done
  return 1
}

# nwn_erf chokes on apostrophes (and is fragile around spaces) in input
# paths. Always invoke nasher against a sanitized symlink in /tmp.
# Echoes the safe path.
sanitize_mod_path() {
  local src=$1
  if [[ ! -f $src ]]; then
    echo "error: $src not found" >&2
    return 1
  fi
  local abs base clean link
  abs=$(realpath "$src")
  base=$(basename "$abs")
  clean=$(printf '%s' "$base" | tr -c '[:alnum:]._-' '_')
  link="/tmp/nwnmgr_${clean}"
  ln -sfn "$abs" "$link"
  printf '%s\n' "$link"
}

# Detect the NWN game-data install root for TLK extraction.
# Resolution order:
#   1. $NWN_INSTALL (if set and exists)
#   2. Walk up from .nasher/source assuming <install>/data/mod/<name>.mod
#      (legacy path — was true when .mod lived in the Steam install dir)
#   3. Fixed fallback list of common Steam install locations on Linux
#
# Note: the EE *user* directory (~/.local/share/Neverwinter Nights/) does
# NOT count as an "install" here — it has no dialog.tlk. When the .mod
# lives in <userdir>/modules/<name>.mod (the modern layout), .nasher/source
# can't help us find dialog.tlk and we fall through to the fallback list.
detect_nwn_install() {
  if [[ -n "${NWN_INSTALL:-}" && -d "$NWN_INSTALL" ]]; then
    printf '%s\n' "$NWN_INSTALL"; return 0
  fi

  if [[ -f .nasher/source ]]; then
    local mod_path mod_dir parent
    mod_path=$(cat .nasher/source)
    mod_dir=$(dirname "$mod_path")
    parent=$(dirname "$mod_dir")
    if [[ "$(basename "$mod_dir")" == "mod" && "$(basename "$parent")" == "data" ]]; then
      printf '%s\n' "$(dirname "$parent")"
      return 0
    fi
  fi

  local cand
  for cand in \
    "$HOME/.local/share/Steam/steamapps/common/Neverwinter Nights" \
    "/var/home/$USER/.local/share/Steam/steamapps/common/Neverwinter Nights" \
    "$HOME/.steam/steam/steamapps/common/Neverwinter Nights" \
    "/opt/nwn"
  do
    if [[ -f "$cand/lang/en/data/dialog.tlk" || -f "$cand/data/tlk/dialog.tlk" ]]; then
      printf '%s\n' "$cand"; return 0
    fi
  done
}

# Detect the NWN:EE user directory (where modules/, hak/, override/ live).
# Resolution order: $NWN_USERDIR, then platform defaults.
detect_nwn_userdir() {
  if [[ -n "${NWN_USERDIR:-}" && -d "$NWN_USERDIR" ]]; then
    printf '%s\n' "$NWN_USERDIR"; return 0
  fi
  local cand
  for cand in \
    "$HOME/.local/share/Neverwinter Nights" \
    "/var/home/$USER/.local/share/Neverwinter Nights" \
    "$HOME/Documents/Neverwinter Nights"
  do
    if [[ -d "$cand/hak" || -d "$cand/modules" ]]; then
      printf '%s\n' "$cand"; return 0
    fi
  done
}

# Extract each hak the module declares (via Mod_HakList) into its own
# scratch directory of plain files, for use as nwnsc's -i include-path list
# (nwnsc, unlike the old nwn_script_comp --erfs, has no ability to load
# .hak/.erf archives directly — only plain filesystem directories).
# Echoes one scratch-dir path per line; empty if module.ifo.json or userdir
# is missing. NOTE: the caller is responsible for registering the returned
# paths for cleanup — this function may be invoked via command substitution
# (a subshell), whose traps do not propagate back to the caller's shell.
extract_hak_includes() {
  [[ -f unpacked/module.ifo.json ]] || return 0
  local userdir
  userdir=$(detect_nwn_userdir) || return 0
  [[ -d "$userdir/hak" ]] || return 0

  local haks
  haks=$(run_pytool hak-list "unpacked/module.ifo.json") || return 0

  local h hak dir
  while IFS= read -r h; do
    [[ -z $h ]] && continue
    hak="$userdir/hak/${h}.hak"
    if [[ ! -f $hak ]]; then
      echo "[$PROG] warn: declared hak $h.hak not found at $hak — compiler may miss its includes" >&2
      continue
    fi
    dir=$(mktemp -d "${TMPDIR:-/tmp}/nwnmgr_hakx_${h}_XXXXXX")
    if ( cd "$dir" && nwn_erf -x -f "$hak" ) >/dev/null 2>&1; then
      printf '%s\n' "$dir"
    else
      echo "[$PROG] warn: failed to extract $h.hak — compiler may miss its includes" >&2
      rm -rf "$dir"
    fi
  done <<< "$haks"
}

# Extract the base dialog.tlk and the custom TLK (named in module.ifo's
# Mod_CustomTlk, if any) from the NWN install into ./tlk/. Non-fatal: if
# the install can't be located, the wiki still renders but TLK refs stay
# as [TLK#N] placeholders.
extract_tlks() {
  rm -rf tlk
  mkdir -p tlk

  local install
  install=$(detect_nwn_install)
  if [[ -z $install ]]; then
    echo "[$PROG] NWN install not detected (set NWN_INSTALL=...) — skipping TLK extract" >&2
    return 0
  fi

  local dialog=""
  for cand in "$install/lang/en/data/dialog.tlk" "$install/data/tlk/dialog.tlk"; do
    [[ -f $cand ]] && { dialog=$cand; break; }
  done
  if [[ -n $dialog ]]; then
    cp "$dialog" tlk/dialog.tlk
    echo "[$PROG] copied $dialog → tlk/dialog.tlk"
  else
    echo "warn: dialog.tlk not found under $install" >&2
  fi

  local custom_name=""
  if [[ -f unpacked/module.ifo.json ]]; then
    custom_name=$(run_pytool tlk-name "unpacked/module.ifo.json" 2>/dev/null || true)
  fi
  if [[ -n $custom_name ]]; then
    local custom=""
    for cand in "$install/data/tlk/${custom_name}.tlk" "$install/lang/en/data/${custom_name}.tlk"; do
      [[ -f $cand ]] && { custom=$cand; break; }
    done
    if [[ -n $custom ]]; then
      cp "$custom" "tlk/${custom_name}.tlk"
      echo "[$PROG] copied $custom → tlk/${custom_name}.tlk"
    else
      echo "warn: custom TLK '${custom_name}.tlk' not found under $install" >&2
    fi
  fi
}

# Append a literal entry to .gitignore if missing. Idempotent so existing
# projects pick up the /tlk/ rule the first time they re-unpack.
ensure_gitignore_entry() {
  local entry=$1
  [[ -f .gitignore ]] || return 0
  grep -qxF "$entry" .gitignore && return 0
  printf '%s\n' "$entry" >> .gitignore
  echo "[$PROG] added '$entry' to .gitignore"
}

# Print a one-line summary of unpacked/ contents.
print_unpacked_summary() {
  [[ -d unpacked ]] || return 0
  local total
  total=$(find unpacked -type f | wc -l)
  echo "[$PROG] unpacked/ summary:"
  echo "  total files: $total"
  find unpacked -type f \
    | sed -n 's/.*\.\([^./]*\)$/\1/p' \
    | sort | uniq -c | sort -rn \
    | sed 's/^/  /'
}

cmd_init() {
  if [[ $# -lt 2 ]]; then
    echo "error: init requires <project-dir> <module.mod>" >&2
    echo "usage: $PROG init <project-dir> <module.mod>" >&2
    exit 2
  fi
  local project=$1 mod=$2
  if [[ -e $project && -n "$(ls -A "$project" 2>/dev/null)" ]]; then
    echo "error: $project exists and is not empty" >&2
    exit 1
  fi
  if [[ ! -f $mod ]]; then
    echo "error: module not found: $mod" >&2
    exit 1
  fi

  local mod_abs
  mod_abs=$(realpath "$mod")
  mkdir -p "$project"
  project=$(realpath "$project")
  cd "$project"

  local clean_mod
  clean_mod=$(sanitize_mod_path "$mod_abs")

  echo "[$PROG] initializing $project from $mod_abs"
  # nasher init creates nasher.cfg and a src/ tree from the .mod.
  # --default + --skipPkgInfo + --yes keeps it non-interactive. We
  # post-rewrite src → unpacked below.
  nasher init --default --skipPkgInfo --yes . "$clean_mod"

  if [[ -d src ]]; then
    mv src unpacked
  fi
  # Patch nasher.cfg: src → unpacked in include + rules.
  # (Portable in-place edit: BSD/macOS `sed -i` requires a backup-suffix
  # argument, unlike GNU sed, so round-trip through a temp file instead.)
  sed \
    -e 's|"src/\*\*|"unpacked/**|g' \
    -e 's|"\*" = "src"|"*" = "unpacked"|g' \
    nasher.cfg > nasher.cfg.tmp && mv nasher.cfg.tmp nasher.cfg

  mkdir -p .nasher
  printf '%s\n' "$mod_abs" > .nasher/source

  # Per-project .gitignore. tlk/ is sourced from the NWN install at unpack time.
  cat > .gitignore <<'EOF'
/.nasher/
/dist/
/tlk/
*.mod
*.ncs
*.erf
*.hak
EOF

  # Stub README (don't overwrite if the user-or-nasher already wrote one).
  if [[ ! -f README.md ]]; then
    local mod_basename
    mod_basename=$(basename "$mod_abs")
    cat > README.md <<EOF
# $(basename "$project")

NWN1 module project unpacked from \`$mod_basename\` for git-friendly,
LLM-editable editing.

## Workflow

\`\`\`
nwn-manager unpack       # refresh unpacked/ from the .mod
# edit JSON / .nss in unpacked/
nwn-manager repack       # build .mod and copy back to install location
nwn-manager wiki         # regenerate docs/ (committed; published by GitHub Pages)
\`\`\`

The source/install path is recorded in \`.nasher/source\` (per-machine,
gitignored). Pass an explicit path to \`unpack\` to point at a different
.mod.
EOF
  fi

  print_unpacked_summary
  echo "[$PROG] project ready at: $project"
}

cmd_unpack() {
  local root
  root=$(find_project_root) || {
    echo "error: not inside an nwn-manager project (no nasher.cfg found above $PWD)" >&2
    echo "       run '$PROG init <dir> <module.mod>' to create one" >&2
    exit 1
  }
  cd "$root"

  local mod=""
  if [[ $# -ge 1 ]]; then
    mod=$(realpath "$1")
    [[ -f $mod ]] || { echo "error: $mod not found" >&2; exit 1; }
    mkdir -p .nasher
    printf '%s\n' "$mod" > .nasher/source
  elif [[ -f .nasher/source ]]; then
    mod=$(cat .nasher/source)
    [[ -f $mod ]] || {
      echo "error: stored source $mod no longer exists" >&2
      echo "       pass an explicit path: $PROG unpack <module.mod>" >&2
      exit 1
    }
  else
    echo "error: no .nasher/source recorded; pass <module.mod> explicitly" >&2
    exit 1
  fi

  local clean_mod
  clean_mod=$(sanitize_mod_path "$mod")
  # Wipe unpacked/ first so resources deleted in the toolset don't linger
  # in the source tree (and silently sneak back into the next repack).
  if [[ -d unpacked ]]; then
    echo "[$PROG] clearing $root/unpacked/"
    rm -rf unpacked
  fi
  echo "[$PROG] unpacking $mod → $root/unpacked/"
  nasher unpack --yes --file:"$clean_mod"

  ensure_gitignore_entry "/tlk/"
  extract_tlks

  print_unpacked_summary
}

# Read the `file = "..."` value from the first [target] in nasher.cfg.
# Echoes the bare filename or empty if not found. Used to locate the .mod
# nasher just packed; nasher writes it to the project root by default.
nasher_target_file() {
  [[ -f nasher.cfg ]] || return 0
  awk '
    /^\[target/ { in_target=1; next }
    /^\[/        { in_target=0 }
    in_target && /^[[:space:]]*file[[:space:]]*=/ {
      sub(/^[^=]*=[[:space:]]*"?/, "")
      sub(/"?[[:space:]]*$/, "")
      print; exit
    }
  ' nasher.cfg
}

cmd_repack() {
  local root
  root=$(find_project_root) || {
    echo "error: not inside an nwn-manager project (no nasher.cfg found above $PWD)" >&2
    exit 1
  }
  cd "$root"

  # --no-smoke skips ALL build gates (the module's tests/smoke-test and the
  # built-in dialog-integrity check). Strip it from the args before the rest
  # are forwarded to nasher.
  local no_smoke=0
  local pass_through=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-smoke) no_smoke=1 ;;
      *)          pass_through+=("$1") ;;
    esac
    shift
  done
  set -- ${pass_through[@]+"${pass_through[@]}"}

  # Built-in, module-agnostic build gate: refuse to build/install a module whose
  # conversations are structurally broken in ways nwn_gff packs silently but the
  # game engine rejects at load (e.g. DLG link structs pasted into node lists).
  # Applies to every module; bypass with --no-smoke.
  if [[ $no_smoke -eq 0 && -x "$SCRIPT_DIR/check-dlg-integrity" && -d "$root/unpacked" ]]; then
    echo "[$PROG] checking dialog integrity: unpacked/*.dlg.json"
    local dlg_out dlg_exit
    dlg_out=$(run_pytool check-dlg-integrity "$root/unpacked" 2>&1) && dlg_exit=0 || dlg_exit=$?
    [[ -n $dlg_out ]] && echo "$dlg_out"
    if (( dlg_exit != 0 )); then
      echo "[$PROG] dialog-integrity check FAILED — aborting repack (nothing built or installed)" >&2
      return 1
    fi
  fi

  # Module-provided build gate (optional, module-agnostic): if the project ships
  # an executable tests/smoke-test, run it first and abort the repack on failure
  # so a non-compliant module never builds or installs. The module owns the
  # actual checks; nwn-manager only knows to run this entrypoint.
  if [[ $no_smoke -eq 0 && -x "$root/tests/smoke-test" ]]; then
    echo "[$PROG] running module smoke tests: tests/smoke-test"
    local smoke_out smoke_exit
    smoke_out=$("$root/tests/smoke-test" 2>&1) && smoke_exit=0 || smoke_exit=$?
    [[ -n $smoke_out ]] && echo "$smoke_out"
    local pass_count fail_count total
    pass_count=$(echo "$smoke_out" | grep -cE '^(ok)[: ]' || true)
    fail_count=$(echo "$smoke_out" | grep -cE '^(fail|not ok)[: ]' || true)
    total=$(( pass_count + fail_count ))
    if (( total > 0 )); then
      echo "[$PROG] $pass_count/$total smoke tests passed"
    fi
    if (( smoke_exit != 0 )); then
      echo "[$PROG] smoke tests FAILED — aborting repack (nothing built or installed)" >&2
      return 1
    fi
  fi

  # All cleanup (hak-extraction scratch dirs below, plus the build-stamp
  # file further down) is accumulated into this single EXIT trap. A second
  # `trap ... EXIT` call OVERWRITES rather than adds to the first, so every
  # site that needs cleanup must append to $_repack_cleanup_paths and
  # re-register the trap with the full accumulated string — never call
  # `trap ... EXIT` with a partial/one-off value.
  _repack_cleanup_paths=""

  # Resolve the bundled base-game scripts dir (nwscript.nss and the base/SoU/
  # HotU includes). The old nwn_script_comp could pull these straight out of
  # a live NWN install's .bif/.key files via --root; nwnsc has no equivalent
  # that works on server-only boxes with no game client installed, so a
  # pre-extracted copy is vendored at nwn-tools/base-scripts/ instead.
  local base_scripts=""
  if [[ -n ${NWN_BASE_SCRIPTS_DIR:-} && -d $NWN_BASE_SCRIPTS_DIR ]]; then
    base_scripts=$NWN_BASE_SCRIPTS_DIR
  elif [[ -n ${NWN_TOOLS_DIR:-} && -d "$NWN_TOOLS_DIR/base-scripts" ]]; then
    base_scripts="$NWN_TOOLS_DIR/base-scripts"
  elif [[ -d "$SCRIPT_DIR/../nwn-tools/base-scripts" ]]; then
    base_scripts="$SCRIPT_DIR/../nwn-tools/base-scripts"
  elif [[ -d "$SCRIPT_DIR/../../nwn-tools/base-scripts" ]]; then
    base_scripts="$SCRIPT_DIR/../../nwn-tools/base-scripts"
  fi
  if [[ -z $base_scripts ]]; then
    echo "[$PROG] warn: no base-scripts dir found (checked \$NWN_BASE_SCRIPTS_DIR, nwn-tools/base-scripts) — base-game includes like nwscript.nss may fail to resolve" >&2
  fi

  # Extract the haks the module declares so the compiler can resolve
  # includes (e.g. zep_inc_main.nss, ITEM_PROPERTY_BOOMERANG,
  # gplotAppraiseOpenStore from CEP / engine base). Without this, nwnsc only
  # sees nss in unpacked/ and most CEP-dependent scripts fail to compile.
  # Read via process substitution (not a pipe) so the loop runs in THIS
  # shell, not a subshell — needed for both array/variable accumulation
  # below to actually persist past the loop.
  local nss_include_dirs=()
  [[ -n $base_scripts ]] && nss_include_dirs+=("$base_scripts")
  local hak_dir
  while IFS= read -r hak_dir; do
    [[ -z $hak_dir ]] && continue
    nss_include_dirs+=("$hak_dir")
    _repack_cleanup_paths+=" $(printf '%q' "$hak_dir")"
  done < <(extract_hak_includes)
  [[ -n $_repack_cleanup_paths ]] && trap "rm -rf${_repack_cleanup_paths}" EXIT

  # nwnsc resolves #include "X" by looking for a file literally named X.nss —
  # unlike nwn_script_comp's resman, it is case-sensitive. Base-game/CEP
  # scripts (and some project scripts) were written assuming a
  # case-insensitive filesystem, so on Linux/most macOS setups those includes
  # fail with NSC1085 "Unable to open the include file" unless a directory of
  # case-corrected symlinks is generated and added to -i. See
  # nwn-tools/gen_include_shims.sh for details.
  local shim_script=""
  if [[ -n ${NWN_TOOLS_DIR:-} && -x "$NWN_TOOLS_DIR/gen_include_shims.sh" ]]; then
    shim_script="$NWN_TOOLS_DIR/gen_include_shims.sh"
  elif [[ -x "$SCRIPT_DIR/../nwn-tools/gen_include_shims.sh" ]]; then
    shim_script="$SCRIPT_DIR/../nwn-tools/gen_include_shims.sh"
  elif [[ -x "$SCRIPT_DIR/../../nwn-tools/gen_include_shims.sh" ]]; then
    shim_script="$SCRIPT_DIR/../../nwn-tools/gen_include_shims.sh"
  fi
  if [[ -n $shim_script && -d "$root/unpacked" ]]; then
    local shim_dir
    shim_dir=$(mktemp -d "${TMPDIR:-/tmp}/nwnmgr_shims_XXXXXX")
    _repack_cleanup_paths+=" $(printf '%q' "$shim_dir")"
    trap "rm -rf${_repack_cleanup_paths}" EXIT
    # ${nss_include_dirs[@]+"${nss_include_dirs[@]}"}, not "${arr[@]:-}": the
    # array can be genuinely empty here (no base-scripts dir, no haks), and
    # ":-" would pass one stray empty-string directory argument instead of
    # zero - gen_include_shims.sh/nwnsc would then treat "" as a real (and
    # wrong) path segment rather than simply having one fewer directory.
    if "$shim_script" "$shim_dir" "$root/unpacked" \
        ${nss_include_dirs[@]+"${nss_include_dirs[@]}"} >&2; then
      nss_include_dirs=("$shim_dir" ${nss_include_dirs[@]+"${nss_include_dirs[@]}"})
    else
      echo "[$PROG] warn: gen_include_shims.sh failed — case-mismatched #includes may not resolve" >&2
    fi
  else
    echo "[$PROG] warn: gen_include_shims.sh not found — case-mismatched #includes (e.g. NW_I0_SPELLS vs nw_i0_spells.nss) may fail to resolve" >&2
  fi

  local pack_args=(--yes)
  local nwnsc_bin
  nwnsc_bin=$(command -v nwnsc || true)
  if [[ -n $nwnsc_bin ]]; then
    pack_args+=("--nssCompiler:$nwnsc_bin")
    if [[ ${#nss_include_dirs[@]} -gt 0 ]]; then
      local nss_include
      nss_include=$(IFS=';'; echo "${nss_include_dirs[*]}")
      # -lowqey: load base resources, optimize, non-BioWare extensions,
      # quiet, continue-on-error — the exact flag string already proven in
      # production across this user's other nasher/nwnsc projects.
      pack_args+=("--nssFlags:-lowqey -i $nss_include")
      echo "[$PROG] compiler: $nwnsc_bin -i $nss_include"
    else
      echo "[$PROG] compiler: $nwnsc_bin (no -i include dirs resolved)"
    fi
  else
    echo "[$PROG] warn: nwnsc not found — nasher will fall back to its own default compiler resolution" >&2
  fi

  # Build stamp (module-agnostic; opt-in at runtime): generate a tiny script that
  # reports when/what was built. A module opts in by calling
  #   ExecuteScript("nwnmgr_bstamp", oPC);
  # from any event (e.g. OnClientEnter). The resref is resolved at runtime, so it
  # safely no-ops in modules that never reference it. Generated transiently and
  # removed after pack (RETURN trap) so the source tree stays clean — no git
  # churn, no per-module .gitignore needed.
  local stamp_nss="$root/unpacked/nwnmgr_bstamp.nss"
  if [[ -d "$root/unpacked" ]]; then
    # Honor TZ from server.env if present (matches cmd_wiki's timezone handling).
    if [[ -f "$root/server.env" ]]; then
      local _tz
      # shellcheck disable=SC1091
      _tz=$(. "$root/server.env" 2>/dev/null && echo "${TZ:-}")
      [[ -n $_tz ]] && export TZ="$_tz"
    fi
    local stamp_when stamp_git stamp
    stamp_when=$(date '+%Y-%m-%d %H:%M %Z')
    # Skip automated wiki-refresh commits so they don't obscure when real edits happened.
    local _last_real
    _last_real=$(git -C "$root" log --format="%H" --invert-grep \
      --grep="^Auto Wiki Activity Refresh:" -1 2>/dev/null || true)
    if [[ -n $_last_real ]]; then
      stamp_git=$(git -C "$root" describe --tags --always "$_last_real" 2>/dev/null \
        || git -C "$root" rev-parse --short "$_last_real" 2>/dev/null || true)
      # Still flag uncommitted working-tree changes.
      if ! git -C "$root" diff --quiet 2>/dev/null \
          || ! git -C "$root" diff --cached --quiet 2>/dev/null; then
        stamp_git="${stamp_git}-dirty"
      fi
    else
      stamp_git=$(git -C "$root" describe --tags --always --dirty 2>/dev/null || true)
      [[ -z $stamp_git ]] && stamp_git=$(git -C "$root" rev-parse --short HEAD 2>/dev/null || true)
    fi
    if [[ -n $stamp_git ]]; then
      stamp="$stamp_when (git $stamp_git)"
    else
      stamp="$stamp_when"
    fi
    # Escape backslashes and double-quotes for the NWScript string literal.
    local stamp_esc=${stamp//\\/\\\\}; stamp_esc=${stamp_esc//\"/\\\"}
    cat >"$stamp_nss" <<EOF
// AUTO-GENERATED by nwn-manager repack — regenerated each build, do not edit.
// Opt in from any module event: ExecuteScript("nwnmgr_bstamp", oPC);
void main() { SendMessageToPC(OBJECT_SELF, "Module last edited: $stamp_esc"); }
EOF
    # Expand the path into the trap NOW (set-time): $stamp_nss is function-local
    # and is out of scope by the time an EXIT trap would run. Merge into the
    # shared cleanup accumulator (see note above) rather than a standalone
    # `trap ... EXIT` call, which would silently drop the hak-scratch-dir
    # cleanup registered earlier.
    _repack_cleanup_paths+=" $(printf '%q' "$stamp_nss")"
    trap "rm -rf${_repack_cleanup_paths}" EXIT
    echo "[$PROG] build stamp: $stamp"
  fi

  nasher pack "${pack_args[@]}" "$@"

  # nasher's default output location is the project root, named per the
  # target's `file = ...`. Older configs that route through dist/ still work
  # via the fallback below.
  local built=""
  local target_file
  target_file=$(nasher_target_file)
  if [[ -n $target_file && -f $target_file ]]; then
    built=$(realpath "$target_file")
  elif [[ -d dist ]]; then
    built=$(ls -t dist/*.mod 2>/dev/null | head -1 || true)
    [[ -n $built ]] && built=$(realpath "$built")
  fi

  if [[ -z $built ]]; then
    echo "[$PROG] no built .mod found at project root or in dist/ — skipping install copy" >&2
    return 0
  fi
  echo "[$PROG] built: $built"

  if [[ -f .nasher/source ]]; then
    local install
    install=$(cat .nasher/source)
    if [[ ! -d $(dirname "$install") ]]; then
      echo "[$PROG] install dir $(dirname "$install") does not exist — skipping copy" >&2
      return 0
    fi
    cp -v "$built" "$install"
    echo "[$PROG] installed to: $install"
  fi
}

cmd_wiki() {
  local root
  root=$(find_project_root) || {
    echo "error: not inside an nwn-manager project (no nasher.cfg found above $PWD)" >&2
    exit 1
  }
  cd "$root"

  # Export TZ from server.env so activity-page timezone label is correct.
  # shellcheck disable=SC1091
  [[ -f server.env ]] && . server.env && export TZ

  local out=docs
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --out)
        [[ -n ${2:-} ]] || { echo "error: --out requires a directory" >&2; exit 2; }
        out=$2; shift 2
        ;;
      *) break ;;
    esac
  done

  local tlk_args=()
  if [[ -f tlk/dialog.tlk ]]; then
    tlk_args+=(--dialog-tlk tlk/dialog.tlk)
  else
    local install
    install=$(detect_nwn_install || true)
    if [[ -n $install ]]; then
      for _cand in "$install/lang/en/data/dialog.tlk" "$install/data/tlk/dialog.tlk"; do
        if [[ -f $_cand ]]; then
          tlk_args+=(--dialog-tlk "$_cand")
          echo "[$PROG] using dialog.tlk from $_cand"
          break
        fi
      done
    fi
  fi
  local custom=""
  for f in tlk/*.tlk; do
    [[ -f $f ]] || continue
    [[ "$(basename "$f")" == "dialog.tlk" ]] && continue
    custom=$f
    break
  done
  if [[ -n $custom ]]; then
    tlk_args+=(--custom-tlk "$custom")
  fi

  # ${tlk_args[@]+"${tlk_args[@]}"} (not a bare ${tlk_args[@]}): tlk_args may
  # end up genuinely empty (no tlk/dialog.tlk and no NWN install detected),
  # and expanding a zero-element array with plain ${arr[@]} raises "unbound
  # variable" under `set -u` on bash < 4.4 (e.g. macOS's system bash 3.2),
  # even though the array itself was declared with `local tlk_args=()`.
  # (${arr[@]:-} avoids the crash too, but wrongly passes one stray
  # empty-string argument when the array is empty instead of zero arguments
  # - use the ${arr[@]+"${arr[@]}"} form, already used for $pass_through
  # above, which is correct in both cases.)
  run_pytool_exec wiki --src unpacked --out "$out" \
    ${tlk_args[@]+"${tlk_args[@]}"} "$@"
}

cmd_console() {
  # Multi-project console. Unlike edit-areas, it is NOT scoped to the current
  # project - it manages every project under --projects-dir. Default projects
  # dir is a sibling of the repo (SCRIPT_DIR/../projects).
  local projects_dir=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --projects-dir)
        [[ -n ${2:-} ]] || { echo "error: --projects-dir requires a directory" >&2; exit 2; }
        projects_dir=$2; shift 2
        ;;
      *) break ;;
    esac
  done
  if [[ -z $projects_dir ]]; then
    projects_dir=$(cd "$SCRIPT_DIR/.." && pwd)/projects
  fi
  mkdir -p "$projects_dir"
  run_pytool_exec area-editor --projects-dir "$projects_dir" \
    --nwn-manager "$SCRIPT_DIR/nwn-manager" \
    --landing-dir "$(cd "$SCRIPT_DIR/.." && pwd)" "$@"
}

cmd_edit_areas() {
  local root
  root=$(find_project_root) || {
    echo "error: not inside an nwn-manager project (no nasher.cfg found above $PWD)" >&2
    exit 1
  }
  cd "$root"

  local dir=unpacked
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir)
        [[ -n ${2:-} ]] || { echo "error: --dir requires a directory" >&2; exit 2; }
        dir=$2; shift 2
        ;;
      *) break ;;
    esac
  done

  run_pytool_exec area-editor --dir "$dir" \
    --nwn-manager "$SCRIPT_DIR/nwn-manager" \
    --landing-dir "$(cd "$SCRIPT_DIR/.." && pwd)" "$@"
}

cmd_serve() {
  local root
  root=$(find_project_root) || {
    echo "error: not inside a project (no nasher.cfg found)" >&2
    exit 1
  }
  cd "$root"

  # Export TZ from server.env so activity-page timezone label is correct.
  # shellcheck disable=SC1091
  [[ -f server.env ]] && . server.env && export TZ

  local log_dirs=()
  local poll_interval=5
  local auto_publish=0
  local activity_cache=""
  local db_dir=""
  local backup_cmd=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --log-dir)
        [[ -n ${2:-} ]] || { echo "error: --log-dir requires a directory" >&2; exit 2; }
        log_dirs+=("$2"); shift 2
        ;;
      --poll-interval)
        [[ -n ${2:-} ]] || { echo "error: --poll-interval requires a number" >&2; exit 2; }
        poll_interval=$2; shift 2
        ;;
      --auto-publish)
        auto_publish=1; shift
        ;;
      --activity-cache)
        [[ -n ${2:-} ]] || { echo "error: --activity-cache requires a path" >&2; exit 2; }
        activity_cache=$2; shift 2
        ;;
      --db-dir)
        [[ -n ${2:-} ]] || { echo "error: --db-dir requires a directory" >&2; exit 2; }
        db_dir=$2; shift 2
        ;;
      --backup-cmd)
        [[ -n ${2:-} ]] || { echo "error: --backup-cmd requires a command" >&2; exit 2; }
        backup_cmd=$2; shift 2
        ;;
      *) echo "error: unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
  done

  if [[ ${#log_dirs[@]} -eq 0 ]]; then
    echo "error: at least one --log-dir is required" >&2
    usage >&2
    exit 2
  fi

  local wiki_activity="$SCRIPT_DIR/nwn-wiki-activity"
  if [[ ! -f $wiki_activity ]]; then
    echo "error: nwn-wiki-activity not found at $wiki_activity" >&2
    exit 1
  fi

  local log_dir_args=()
  for d in "${log_dirs[@]}"; do
    log_dir_args+=(--log-dir "$d")
  done
  # cache_args/db_dir_args are optional and may stay genuinely empty (no
  # --activity-cache/--db-dir passed) - always expand them as
  # ${arr[@]+"${arr[@]}"} below (matches $pass_through/$tlk_args elsewhere in
  # this file), never a bare "${arr[@]}" (raises "unbound variable" under
  # `set -u` on bash < 4.4 for a zero-element array) or "${arr[@]:-}" (avoids
  # the crash but wrongly passes one stray empty-string argument).
  local cache_args=()
  [[ -n $activity_cache ]] && cache_args+=(--activity-cache "$activity_cache")
  local db_dir_args=()
  [[ -n $db_dir ]] && db_dir_args+=(--db-dir "$db_dir")

  # The server container is (re)started together with this monitor, so at this
  # moment no player can be online yet — the module hasn't even loaded.  Pass our
  # own start time as a floor: any session still "open" in the logs that began
  # before now is a leftover from the previous run (killed without a clean leave)
  # and must not be reported as online.  Genuine players re-join after this point.
  local serve_started
  serve_started=$(date +%s)
  local since_args=(--online-since "$serve_started")

  local poll_secs=$(( poll_interval * 60 ))
  local publish_label
  publish_label=$([ $auto_publish -eq 1 ] && echo "enabled" || echo "disabled")

  echo "[$PROG] serve: monitoring player activity every ${poll_interval}m" \
       "(auto-publish: ${publish_label})"
  echo "[$PROG] serve: project root: $root"

  while true; do
    local _now
    _now=$(date '+%Y-%m-%d %H:%M:%S')
    # Trigger when: no players currently online AND a logout occurred within
    # the last poll window.  This fires at most once per poll period per
    # session end, naturally self-clears when the window expires, and
    # survives monitor restarts without any saved state.
    if run_pytool wiki-activity --check-should-refresh "$poll_secs" \
        "${log_dir_args[@]}" ${cache_args[@]+"${cache_args[@]}"} "${since_args[@]}" 2>/dev/null; then
      echo "[$PROG] serve: $_now — no players + recent logout; refreshing activity page"
      if run_pytool wiki-activity \
          --src unpacked --out docs \
          "${log_dir_args[@]}" ${cache_args[@]+"${cache_args[@]}"} "${since_args[@]}" ${db_dir_args[@]+"${db_dir_args[@]}"}; then
        echo "[$PROG] serve: activity page refreshed"
        if [[ $auto_publish -eq 1 ]]; then
          local ts
          ts=$(date '+%Y-%m-%d %H:%M:%S')
          local changed_files=(docs/activity.html)
          [[ -n $db_dir ]] && changed_files+=(docs/manual/ServerFirsts.html)
          local any_changed=0
          for f in "${changed_files[@]}"; do
            [[ -n "$(git -C "$root" status --porcelain -- "$f" 2>/dev/null)" ]] && any_changed=1
          done
          if [[ $any_changed -eq 0 ]]; then
            echo "[$PROG] serve: no changes to wiki pages; skipping commit"
          elif git -C "$root" add -- "${changed_files[@]}" \
            && git -C "$root" commit -m "Auto Wiki Activity Refresh: $ts" \
            && git -C "$root" push; then
            echo "[$PROG] serve: committed and pushed activity update ($ts)"
          else
            echo "[$PROG] serve: warn: git publish failed; will retry next poll" >&2
          fi
        fi
      else
        echo "[$PROG] serve: warn: activity page refresh failed" >&2
      fi
      # Opportunistic backup at a quiet moment (no players online). The backup
      # command self-gates on its own 24h sentinel, so calling it every idle
      # cycle is harmless; this just gets a backup sooner than the daily timer
      # when the server happens to empty out. Best-effort: never blocks serving.
      if [[ -n $backup_cmd ]]; then
        if "$backup_cmd"; then :; else
          echo "[$PROG] serve: warn: backup command failed (rc=$?)" >&2
        fi
      fi
    elif run_pytool wiki-activity --check-online \
        "${log_dir_args[@]}" ${cache_args[@]+"${cache_args[@]}"} "${since_args[@]}" 2>/dev/null; then
      echo "[$PROG] serve: $_now — poll: players online"
    fi
    sleep "$poll_secs"
  done
}

main() {
  case "${1:-}" in
    init)
      # Unpacking only needs nasher + nwn_gff (no script compilation).
      shift; preflight nasher nwn_gff
      cmd_init "$@"
      ;;
    unpack)
      shift; preflight nasher nwn_gff
      cmd_unpack "$@"
      ;;
    repack)
      shift; preflight nasher nwn_gff nwn_erf nwnsc
      cmd_repack "$@"
      ;;
    wiki)
      shift; preflight python3
      cmd_wiki "$@"
      ;;
    console)
      shift; preflight python3
      cmd_console "$@"
      ;;
    edit-areas)
      shift; preflight python3
      cmd_edit_areas "$@"
      ;;
    serve)
      shift; preflight python3
      cmd_serve "$@"
      ;;
    -h|--help|"")
      usage
      ;;
    *)
      echo "error: unknown subcommand: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
