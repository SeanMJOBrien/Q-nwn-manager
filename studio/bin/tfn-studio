#!/usr/bin/env python3
"""Launcher for tfn-studio (works from any cwd; no install step)."""
import sys
from pathlib import Path

if sys.version_info < (3, 9):
    sys.exit("tfn-studio needs Python 3.9 or newer (this is %d.%d). On macOS: `brew install python`, "
             "then run `python3 bin/tfn-studio ...`." % sys.version_info[:2])

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from tfnstudio.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
